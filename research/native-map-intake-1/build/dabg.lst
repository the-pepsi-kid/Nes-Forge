000024r 2  AD rr rr       lda keydown+2
000027r 2  8D rr rr       sta keydown+0
00002Ar 2  AD rr rr       lda keydown+3
00002Dr 2  8D rr rr       sta keydown+1
000030r 2  A9 00          lda #0
000032r 2  8D rr rr       sta keydown+2
000035r 2  8D rr rr       sta keydown+3
000038r 2  AD rr rr       lda FourScorePluggedIn
00003Br 2  F0 03          beq :+
00003Dr 2  20 rr rr       jsr ReadJoyOnce
000040r 2               :
000040r 2               
000040r 2  AD rr rr       lda AttractMode
000043r 2  D0 01          bne Attract
000045r 2  60             rts
000046r 2               .else
000046r 2                 lda keydown
000046r 2                 sta keylast
000046r 2                 lda keydown+1
000046r 2                 sta keylast+1
000046r 2                 lda #1
000046r 2                 sta keydown+1
000046r 2                 sta JOY1
000046r 2                 lda #0
000046r 2                 sta JOY1
000046r 2               : lda JOY1
000046r 2                 and #$03
000046r 2                 cmp #1
000046r 2                 rol keydown+0
000046r 2                 lda JOY2
000046r 2                 and #$03
000046r 2                 cmp #1
000046r 2                 rol keydown+1
000046r 2                 bcc :-
000046r 2                 lda AttractMode
000046r 2                 bne Attract
000046r 2                 rts
000046r 2               .endif
