003BE2r 2               ; ppppppmm - win condition, parameter
003BE2r 2               ; ffffdeee - level effect, enemy distribution, max enemy number
003BE2r 2               ; pppeeeee - enemy type 1
003BE2r 2               ; pppeeeee - enemy type 2
003BE2r 2               ; pppeeeee - enemy type 3
003BE2r 2               ; pppeeeee - enemy type 4
003BE2r 2               ; aaaaaaaa - map address low
003BE2r 2               ; aaaaaaaa - map address high
003BE2r 2               
003BE2r 2               WINMODE_REGULAR    = 0
003BE2r 2               WINMODE_GET_COINS  = 1
003BE2r 2               WINMODE_SURVIVAL   = 2
003BE2r 2               WINMODE_HOTELMARIO = 3
003BE2r 2               EPARAM_0           = 0 << 5
003BE2r 2               EPARAM_1           = 1 << 5
003BE2r 2               EPARAM_2           = 2 << 5
003BE2r 2               EPARAM_3           = 3 << 5
003BE2r 2               EPARAM_4           = 4 << 5
003BE2r 2               EPARAM_5           = 5 << 5
003BE2r 2               EPARAM_6           = 6 << 5
003BE2r 2               EPARAM_7           = 7 << 5
003BE2r 2               
003BE2r 2               EFFECT_NONE = $00
003BE2r 2               EFFECT_SCROLL1 = $10 ; scrolling right, slow
003BE2r 2               EFFECT_SCROLL2 = $20 ; scrolling right, medium
003BE2r 2               EFFECT_SCROLL3 = $30 ; scrolling right, fast
003BE2r 2               EFFECT_NOCYCLE = $40 ; no level cycling
003BE2r 2               
