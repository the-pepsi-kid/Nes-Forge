0042BDr 2  10 11 12 13    .byt METATILE_TELEPORT_LEFT, METATILE_TELEPORT_RIGHT, METATILE_BOMB_TRAP, METATILE_KILL_SPIKES, METATILE_INSTANT_SWITCH
0042C1r 2  14           
