0007B4r 2  F0 2B          beq :+
0007B6r 2  B5 rr            lda PlayerPX,x
0007B8r 2  18 69 07         add #7
0007BBr 2  18 65 00         add 0
0007BEr 2  4A               lsr
0007BFr 2  4A               lsr
0007C0r 2  4A               lsr
0007C1r 2  4A               lsr
