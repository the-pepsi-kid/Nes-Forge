003B62r 2  A2 03          ldx #MaxNumPlayers-1
003B64r 2               JoinInLeaveLoop:
003B64r 2  B5 rr          lda keydown,x
003B66r 2  29 80          and #KEY_A
003B68r 2  F0 04          beq :+
003B6Ar 2  A9 01          lda #1
003B6Cr 2  95 rr          sta PlayerEnabled,x
003B6Er 2  B5 rr        : lda keydown,x
003B70r 2  29 40          and #KEY_B
003B72r 2  F0 02          beq :+
003B74r 2  56 rr          lsr PlayerEnabled,x
003B76r 2  B5 rr        : lda PlayerEnabled,x
003B78r 2  9D rr rr       sta PlayerEnabledCopy,x
003B7Br 2  CA             dex
003B7Cr 2  10 E6          bpl JoinInLeaveLoop
003B7Er 2               
003B7Er 2  A5 rr          lda keydown
003B80r 2  05 rr          ora keydown+1
003B82r 2  05 rr          ora keydown+2
003B84r 2  05 rr          ora keydown+3
003B86r 2  29 10          and #KEY_START
003B88r 2  D0 03          bne PressedStart
003B8Ar 2               
003B8Ar 2  4C rr rr       jmp Loop
003B8Dr 2               PressedStart:
003B8Dr 2  20 rr rr       jsr wait_vblank
003B90r 2  A9 00          lda #0
003B92r 2  8D 01 20       sta PPUMASK
003B95r 2  20 rr rr       jsr ClearName
003B98r 2  A9 21          lda #$21
003B9Ar 2  8D 06 20       sta PPUADDR
003B9Dr 2  A9 02          lda #$02
003B9Fr 2  8D 06 20       sta PPUADDR
003BA2r 2  20 rr rr       jsr DrawListOfPlayers
003BA5r 2  A9 00          lda #0
003BA7r 2  8D 05 20       sta PPUSCROLL
003BAAr 2  8D 05 20       sta PPUSCROLL
003BADr 2               
003BADr 2               ; How many players?
003BADr 2  A5 rr          lda PlayerEnabled+0
003BAFr 2  18 65 rr       add PlayerEnabled+1
003BB2r 2  18 65 rr       add PlayerEnabled+2
003BB5r 2  18 65 rr       add PlayerEnabled+3
003BB8r 2  85 00          sta 0
003BBAr 2  D0 03 4C rr    jeq StartMainMenu
003BBEr 2  rr           
003BBFr 2  C9 01          cmp #1
003BC1r 2  D0 03 4C rr    jeq MenuNewGame::Modes1P
003BC5r 2  rr           
003BC6r 2  4C rr rr       jmp MenuNewGame::Modes2P
003BC9r 2               ;  cmp #2
003BC9r 2               ;  jcs MenuNewGame::Modes2P
003BC9r 2               
003BC9r 2               DrawListOfPlayers:
003BC9r 2  A2 00          ldx #0
003BCBr 2  A0 31          ldy #'1'
003BCDr 2               PlayerLoop:
003BCDr 2  B5 rr          lda PlayerEnabled,x
003BCFr 2  D0 07          bne ShowEnabled
003BD1r 2  A9 20          lda #' '
003BD3r 2  8D 07 20       sta PPUDATA
003BD6r 2  D0 03          bne ShowedDisabled
003BD8r 2               ShowEnabled:
003BD8r 2  8C 07 20       sty PPUDATA
003BDBr 2               ShowedDisabled:
003BDBr 2  C8             iny
003BDCr 2  E8             inx
003BDDr 2  E0 04          cpx #MaxNumPlayers
003BDFr 2  D0 EC          bne PlayerLoop
003BE1r 2  60             rts
003BE2r 2               .endproc
003BE2r 2               .endif
