000000r 2               .macro Mul32_ZP low, high, highbits
000000r 2                 pha
000000r 2                 .ifblank highbits
000000r 2                 lda #0
000000r 2                 .elseif
000000r 2                 lda highbits>>2
000000r 2                 .endif
000000r 2                 sta high
000000r 2                 pla
000000r 2                 asl ; *2
000000r 2                 asl ; *4
000000r 2                 asl ; *8
000000r 2                 asl ; *16, finally needing high bits
000000r 2                 rol high
000000r 2                 asl
000000r 2                 rol high
000000r 2                 sta low
000000r 2               .endmacro
000000r 2               
000000r 2               .macro Mul32_PPU temp, highbits, xpos
000000r 2                 pha
000000r 2                 lda highbits>>2
000000r 2                 sta temp
000000r 2                 pla
000000r 2                 asl ; *2
000000r 2                 asl ; *4
000000r 2                 asl ; *8
000000r 2                 asl ; *16, finally needing top bits
000000r 2                 rol temp
000000r 2                 asl
000000r 2                 rol temp
000000r 2                 add xpos
000000r 2                 pha
000000r 2                 lda temp
000000r 2                 sta PPUADDR
000000r 2                 pla
000000r 2                 sta PPUADDR
000000r 2               .endmacro
