005007r 2                 POWERUP_STUN_ALL    ; stuns all enemies
005007r 2                 POWERUP_STUNNED     ; placeholder for a stunned enemy
005007r 2                 POWERUP_MONEY       ; for money-collecting levels
005007r 2                 POWERUP_HEALTH      ; health recovering
005007r 2                 POWERUP_POINTS      ; add points
005007r 2                 POWERUP_BOMBS       ; player can throw bombs for awhile
005007r 2               .endenum
005007r 2               .endif
005007r 2               
005007r 2               .enum
005007r 2                 POWERUP_UNUSED
005007r 2                 POWERUP_STUNNED
005007r 2                 POWERUP_MONEY
005007r 2                 POWERUP_HEALTH
005007r 2                 POWERUP_DIAGSHOOT
005007r 2                 POWERUP_BOMBS
005007r 2                 POWERUP_JUMP
005007r 2                 POWERUP_BILLBLOCK
005007r 2               .endenum
005007r 2               
005007r 2               .proc CreatePowerup ; A = powerup type; output is in Y
005007r 2  85 00          sta 0
005009r 2  A0 00          ldy #0
00500Br 2  B9 rr rr     : lda PowerupF,y
00500Er 2  F0 07          beq Success
005010r 2  C8             iny
005011r 2  C0 03          cpy #PowerupLen
005013r 2  D0 F6          bne :-
005015r 2  18             clc
005016r 2  60             rts
005017r 2               Success:
005017r 2  A9 00          lda #0
005019r 2  99 rr rr       sta PowerupVX,y
00501Cr 2  A5 00          lda 0
00501Er 2  09 80          ora #128 ; enabled
005020r 2  99 rr rr       sta PowerupF,y
005023r 2  84 00          sty 0
005025r 2  20 rr rr       jsr rand_8_safe
005028r 2  A4 00          ldy 0
00502Ar 2  48             pha
00502Br 2  29 F0          and #$f0
00502Dr 2  18 69 04       add #4
005030r 2  99 rr rr       sta PowerupPX,y
005033r 2  86 01          stx 1
005035r 2  68             pla
005036r 2  29 01          and #1
005038r 2  AA             tax
005039r 2  BD rr rr       lda VertSpeeds,x
00503Cr 2  99 rr rr       sta PowerupVY,y
00503Fr 2  BD rr rr       lda VertPositions,x
005042r 2  99 rr rr       sta PowerupPY,y
005045r 2  A6 01          ldx 1
005047r 2  38             sec
005048r 2  60             rts
005049r 2               VertSpeeds:
005049r 2  01 FF          .byt 1, <-1
00504Br 2               VertPositions:
00504Br 2  00 E0          .byt 0, 240-16
00504Dr 2               .endproc
00504Dr 2               
00504Dr 2               .proc RunPowerups
00504Dr 2  A9 00          lda #0
00504Fr 2  85 00          sta 0 ; current powerup counter
005051r 2               
005051r 2               Loop:
005051r 2  A6 00          ldx 0
005053r 2  BD rr rr       lda PowerupF,x
005056r 2  10 5B          bpl SkipPowerup
005058r 2  A4 rr          ldy OamPtr
00505Ar 2  29 0F          and #15
00505Cr 2  09 40          ora #$40
00505Er 2  99 01 02       sta OAM_TILE+(4*0),y
005061r 2  09 50          ora #$50
005063r 2  99 05 02       sta OAM_TILE+(4*1),y
005066r 2               
005066r 2  BD rr rr       lda PowerupPX,x
005069r 2  18 7D rr rr    add PowerupVX,x
00506Dr 2  9D rr rr       sta PowerupPX,x
005070r 2               
005070r 2  BD rr rr       lda PowerupPY,x
005073r 2  18 7D rr rr    add PowerupVY,x
005077r 2  9D rr rr       sta PowerupPY,x
00507Ar 2               
00507Ar 2  BD rr rr       lda PowerupPY,x
00507Dr 2  99 00 02       sta OAM_YPOS+(4*0),y
005080r 2  18 69 08       add #8
005083r 2  99 04 02       sta OAM_YPOS+(4*1),y
005086r 2  A9 03          lda #3
005088r 2  99 02 02       sta OAM_ATTR+(4*0),y
00508Br 2  99 06 02       sta OAM_ATTR+(4*1),y
00508Er 2  BD rr rr       lda PowerupPX,x
005091r 2  38 E5 rr       sub ScrollX+1
005094r 2  99 03 02       sta OAM_XPOS+(4*0),y
005097r 2  99 07 02       sta OAM_XPOS+(4*1),y
00509Ar 2               
00509Ar 2  BD rr rr       lda PowerupPY,x
00509Dr 2  C9 F1          cmp #241
00509Fr 2  90 07          bcc :+
0050A1r 2  A9 00          lda #0
0050A3r 2  9D rr rr       sta PowerupF,x
0050A6r 2  F0 03          beq SkipTouch
0050A8r 2  20 rr rr     : jsr PowerupPlayerTouch
0050ABr 2               SkipTouch:
0050ABr 2  A5 rr          lda OamPtr
0050ADr 2  18 69 08       add #8
0050B0r 2  85 rr          sta OamPtr
0050B2r 2  A8             tay
0050B3r 2               
0050B3r 2               SkipPowerup:
0050B3r 2  E6 00          inc 0
0050B5r 2  A5 00          lda 0
0050B7r 2  C9 03          cmp #PowerupLen
0050B9r 2  D0 96          bne Loop
0050BBr 2  84 rr          sty OamPtr
0050BDr 2  60             rts
0050BEr 2               .endproc
0050BEr 2               
0050BEr 2               .proc PowerupPlayerTouch
0050BEr 2  A0 00          ldy #0
0050C0r 2               PlayerLoop:
0050C0r 2  B9 rr rr       lda PlayerPX,y
0050C3r 2  85 rr          sta TouchLeftA
0050C5r 2  B9 rr rr       lda PlayerPYH,y
0050C8r 2  85 rr          sta TouchTopA
0050CAr 2               
0050CAr 2  BD rr rr       lda PowerupPX,x
0050CDr 2  85 rr          sta TouchLeftB
0050CFr 2  BD rr rr       lda PowerupPY,x
0050D2r 2  85 rr          sta TouchTopB
0050D4r 2               
0050D4r 2  A9 08          lda #8
0050D6r 2  85 rr          sta TouchWidthA
0050D8r 2  85 rr          sta TouchWidthB
0050DAr 2  0A             asl
0050DBr 2  85 rr          sta TouchHeightA
0050DDr 2  85 rr          sta TouchHeightB
0050DFr 2               
0050DFr 2  20 rr rr       jsr ChkTouchGeneric
0050E2r 2  B0 06          bcs Touched
0050E4r 2  C8             iny
0050E5r 2  C0 04          cpy #MaxNumPlayers
0050E7r 2  D0 D7          bne PlayerLoop
0050E9r 2  60             rts
0050EAr 2               Touched:
0050EAr 2  86 rr          stx TempVal+2
0050ECr 2                 ; for some bizarre reason I can't just go and play a sound effect here
0050ECr 2                 ; because then it would corrupt memory in addition to playing the sound
0050ECr 2  A9 01          lda #1
0050EEr 2  8D rr rr       sta NeedPowerupSound
0050F1r 2               
0050F1r 2  BD rr rr       lda PowerupF,x  ; get type, push address from table
0050F4r 2  48             pha
0050F5r 2  A9 00          lda #0          ; destroy powerup after we read it
0050F7r 2  9D rr rr       sta PowerupF,x
0050FAr 2  68             pla
0050FBr 2  29 07          and #7
0050FDr 2  0A             asl
0050FEr 2  AA             tax
0050FFr 2  BD rr rr       lda Effects+1,x
005102r 2  48             pha
005103r 2  BD rr rr       lda Effects+0,x
005106r 2  48             pha
005107r 2  A6 rr          ldx TempVal+2
005109r 2  60             rts
00510Ar 2               Effects:
00510Ar 2  rr rr          .raddr PowerupJump
00510Cr 2  rr rr          .raddr PowerupJump
00510Er 2  rr rr          .raddr PowerupMoney
005110r 2  rr rr          .raddr PowerupHealth
005112r 2  rr rr          .raddr PowerupDiagShoot
005114r 2  rr rr          .raddr PowerupBombs
005116r 2  rr rr          .raddr PowerupJump
005118r 2  rr rr          .raddr PowerupBillBlock
00511Ar 2               .endproc
00511Ar 2               
00511Ar 2               .proc PowerupJump
00511Ar 2  A9 03          lda #APOWERUP_JUMP
00511Cr 2  99 rr rr       sta PlayerPowerType,y
00511Fr 2  A9 32          lda #50
005121r 2  99 rr rr       sta PlayerPowerTime,y
005124r 2  60             rts
005125r 2               .endproc
005125r 2               
005125r 2               .proc PowerupDiagShoot
005125r 2  A9 01          lda #APOWERUP_DIAGSHOOT
005127r 2  99 rr rr       sta PlayerPowerType,y
00512Ar 2  A9 32          lda #50
00512Cr 2  99 rr rr       sta PlayerPowerTime,y
00512Fr 2  60             rts
005130r 2               .endproc
005130r 2               
005130r 2               .proc PowerupBombs
005130r 2  A9 02          lda #APOWERUP_BOMBS
005132r 2  99 rr rr       sta PlayerPowerType,y
005135r 2  A9 32          lda #50
005137r 2  99 rr rr       sta PlayerPowerTime,y
00513Ar 2  60             rts
00513Br 2               .endproc
00513Br 2               
00513Br 2               .proc PowerupBillBlock
00513Br 2  A9 04          lda #APOWERUP_BILLBLOCK
00513Dr 2  99 rr rr       sta PlayerPowerType,y
005140r 2  A9 32          lda #50
005142r 2  99 rr rr       sta PlayerPowerTime,y
005145r 2  60             rts
005146r 2               .endproc
005146r 2               
005146r 2               .if 0
005146r 2               .proc PowerupStunAll
005146r 2                 stx 0
005146r 2                 sty 1
005146r 2                 ldx #0
005146r 2               Loop:
005146r 2                 lda ObjectF1,x
005146r 2                 beq Skip
005146r 2                 alr #%111110
005146r 2                 tay
005146r 2                 lda ObjectIsEnemy,y
005146r 2                 beq Skip
005146r 2                 lda #ENEMY_STATE_STUNNED
005146r 2                 sta ObjectF2,x
005146r 2                 lda #250
005146r 2                 sta ObjectTimer,x
005146r 2               Skip:
005146r 2                 inx
005146r 2                 cpx #ObjectLen
005146r 2                 bne Loop
005146r 2                 ldx 0
005146r 2                 ldy 1
005146r 2                 rts
005146r 2               .endproc
005146r 2               .endif
005146r 2               
005146r 2               .proc PowerupMoney
005146r 2  AD rr rr       lda LevelGoalType
005149r 2  C9 01          cmp #1
00514Br 2  D0 08          bne :+
00514Dr 2  AD rr rr       lda LevelGoalParam
005150r 2  F0 03          beq :+
005152r 2  CE rr rr       dec LevelGoalParam
005155r 2               : ; now add points
005155r 2  86 rr          stx TempVal
005157r 2  98             tya
005158r 2  AA             tax
005159r 2  A9 01          lda #1
00515Br 2  20 rr rr       jsr PlayerAddScore
00515Er 2  A6 rr          ldx TempVal
005160r 2  60             rts
005161r 2               .endproc
005161r 2               .proc PowerupHealth
005161r 2  B9 rr rr       lda PlayerHealth,y
005164r 2  C9 04          cmp #MaxHealthNormal
005166r 2  B0 0A          bcs :+
005168r 2  86 rr 48 98    isc PlayerHealth,y
00516Cr 2  AA F6 rr 68  
005170r 2  A6 rr        
005172r 2  60           : rts
005173r 2               .endproc
005173r 2               
005173r 1               .include "math.s"
005173r 2               ;
005173r 2               ; math.s
005173r 2               ; Arithmetic and trigonometry routines for Thwaite
005173r 2               ;
005173r 2               ; Copyright (c) 2011 Damian Yerrick
005173r 2               ;
005173r 2               ; Copying and distribution of this file, with or without
005173r 2               ; modification, are permitted in any medium without royalty provided
005173r 2               ; the copyright notice and this notice are preserved in all source
005173r 2               ; code copies.  This file is offered as-is, without any warranty.
005173r 2               ;
005173r 2               
005173r 2               ;
005173r 2               ; The NES CPU has no FPU, nor does it have a multiplier or divider
005173r 2               ; for integer math.  So we have to implement these in software.
005173r 2               ; Here are subroutines to compute 8x8=16-bit product, a fractional
005173r 2               ; quotient in 0.8 fixed point, 2-argument arctangent, and rectangular
005173r 2               ; to polar coordinate conversion.  Also included are lookup tables of
005173r 2               ; sine and cosine for angles expressed in units of 1/32 of a turn
005173r 2               ; from due right, where cos(0) = cos(32) = sin(8) = 1.0.
005173r 2               ;
005173r 2               ; Further information:
005173r 2               ; http://en.wikipedia.org/wiki/Fixed-point_arithmetic
005173r 2               ; http://en.wikipedia.org/wiki/Binary_multiplier
005173r 2               ; http://en.wikipedia.org/wiki/Boxing_the_compass
005173r 2               ; http://en.wikipedia.org/wiki/Binary_scaling#Binary_angles
005173r 2               ;
005173r 2               
005173r 2               .segment "CODE"
005173r 2               
005173r 2               ;;
005173r 2               ; Multiplies two 8-bit factors to produce a 16-bit product
005173r 2               ; in about 153 cycles.
005173r 2               ; @param A one factor
005173r 2               ; @param Y another factor
005173r 2               ; @return high 8 bits in A; low 8 bits in $0000
005173r 2               ;         Y and $0001 are trashed; X is untouched
005173r 2               .proc mul8
005173r 2               factor2 = TempVal+1
005173r 2               prodlo = TempVal
005173r 2               
005173r 2                 ; Factor 1 is stored in the lower bits of prodlo; the low byte of
005173r 2                 ; the product is stored in the upper bits.
005173r 2  4A             lsr a  ; prime the carry bit for the loop
005174r 2  85 rr          sta prodlo
005176r 2  84 rr          sty factor2
005178r 2  A9 00          lda #0
00517Ar 2  A0 08          ldy #8
00517Cr 2               loop:
00517Cr 2                 ; At the start of the loop, one bit of prodlo has already been
00517Cr 2                 ; shifted out into the carry.
00517Cr 2  90 03          bcc noadd
00517Er 2  18             clc
00517Fr 2  65 rr          adc factor2
005181r 2               noadd:
005181r 2  6A             ror a
005182r 2  66 rr          ror prodlo  ; pull another bit out for the next iteration
005184r 2  88             dey         ; inc/dec don't modify carry; only shifts and adds do
005185r 2  D0 F5          bne loop
005187r 2  A4 rr          ldy TempVal
005189r 2  60             rts
00518Ar 2               .endproc
00518Ar 2               
00518Ar 2               ;;
00518Ar 2               ; Computes 256*a/y.  Useful for finding slopes.
00518Ar 2               ; 0 and 1 are trashed.
00518Ar 2               .proc getSlope1
00518Ar 2               quotient = 0
00518Ar 2               divisor = 1
00518Ar 2               
00518Ar 2  84 01          sty divisor
00518Cr 2  A0 01          ldy #1  ; when this gets ROL'd eight times, the loop ends
00518Er 2  84 00          sty quotient
005190r 2               loop:
005190r 2  0A             asl a
005191r 2  B0 04          bcs alreadyGreater
005193r 2  C5 01          cmp divisor
005195r 2  90 03          bcc nosub
005197r 2               alreadyGreater:
005197r 2  E5 01          sbc divisor
005199r 2  38             sec  ; without this, results using alreadyGreater are wrong
00519Ar 2                      ; thx to http://6502org.wikidot.com/software-math-intdiv
00519Ar 2                      ; for helping solve this
00519Ar 2               nosub:
00519Ar 2  26 00          rol quotient
00519Cr 2  90 F2          bcc loop
00519Er 2  A5 00          lda quotient
0051A0r 2  60             rts
0051A1r 2               .endproc
0051A1r 2               
0051A1r 2               ;;
0051A1r 2               ; Find the angle of a vector pointing from (x1, y1) to (x2, y2),
0051A1r 2               ; all coordinates unsigned.
0051A1r 2               ; This is also called arctan2 or (on TI calculators) "R>Ptheta".
0051A1r 2               ; @param 0 x1
0051A1r 2               ; @param 1 y1
0051A1r 2               ; @param 2 x2
0051A1r 2               ; @param 3 y2
0051A1r 2               ; @return A: angle (0-31);
0051A1r 2               ;         0: slope reflected into first octant;
0051A1r 2               ;         1: angle reflected into first octant;
0051A1r 2               ;         2, 3: point reflected into first octant
0051A1r 2               ;         Trashes Y and nothing else.
0051A1r 2               .proc getAngle
0051A1r 2               x1 = 0
0051A1r 2               y1 = 1
0051A1r 2               x2 = 2
0051A1r 2               y2 = 3
0051A1r 2               flags = 4
0051A1r 2               
0051A1r 2  A5 03          lda y2
0051A3r 2  C5 01          cmp y1
0051A5r 2  D0 0D          bne notHorizontal
0051A7r 2  A5 02          lda x2
0051A9r 2  C5 00          cmp x1
0051ABr 2  A9 00          lda #0
0051ADr 2  85 01          sta 1
0051AFr 2  B0 02          bcs :+
0051B1r 2  A9 10          lda #16
0051B3r 2  60           : rts
0051B4r 2               
0051B4r 2               notHorizontal:
0051B4r 2                 ; make sure x2 > x1
0051B4r 2  A5 02          lda x2
0051B6r 2  C5 00          cmp x1
0051B8r 2  D0 13          bne notVertical
0051BAr 2  A5 03          lda y2
0051BCr 2  C5 01          cmp y1
0051BEr 2  A9 FF          lda #$FF
0051C0r 2  85 03          sta 3
0051C2r 2  A9 00          lda #0  ; store first-octant angle
0051C4r 2  85 01          sta 1
0051C6r 2  A9 18          lda #24
0051C8r 2  90 02          bcc :+
0051CAr 2  A9 08          lda #8
0051CCr 2  60           : rts
0051CDr 2               notVertical:
0051CDr 2               
0051CDr 2                 ; At this point, we have already eliminated the special cases of a
0051CDr 2                 ; perfectly horizontal or vertical ray.
0051CDr 2                 ; So now compute the sign and abs of (y2 - y1)
0051CDr 2  38             sec
0051CEr 2  A5 03          lda y2
0051D0r 2  E5 01          sbc y1
0051D2r 2  B0 04          bcs noVerticalFlip
0051D4r 2  49 FF          eor #$FF
0051D6r 2  69 01          adc #1
0051D8r 2               noVerticalFlip:
0051D8r 2  85 01          sta y1
0051DAr 2               
0051DAr 2  A9 00          lda #0
0051DCr 2  2A             rol a
0051DDr 2  85 04          sta flags  ; flag 2: SKIP y flip (angle = 16 - angle)
0051DFr 2               
0051DFr 2                 ; Compute the sign and abs of (x2 - x1)
0051DFr 2  38             sec
0051E0r 2  A5 02          lda x2
0051E2r 2  E5 00          sbc x1
0051E4r 2  B0 04          bcs noHorizontalFlip
0051E6r 2  49 FF          eor #$FF
0051E8r 2  69 01          adc #1
0051EAr 2               noHorizontalFlip:
0051EAr 2  85 00          sta x1
0051ECr 2  26 04          rol flags  ; flag 1: SKIP x flip (angle = 8 - angle)
0051EEr 2               
0051EEr 2                 ; if x1 > y1 then swap x1 and y1
0051EEr 2  A5 01          lda y1
0051F0r 2  C5 00          cmp x1
0051F2r 2  90 06          bcc noDiagonalFlip
0051F4r 2  A4 00          ldy x1
0051F6r 2  84 01          sty y1
0051F8r 2  85 00          sta x1
0051FAr 2               noDiagonalFlip:
0051FAr 2  26 04          rol flags  ; flag 0: PERFORM diagonal flip (angle = 4 - angle)
0051FCr 2               
0051FCr 2  A5 01          lda y1
0051FEr 2  85 03          sta y2
005200r 2  A4 00          ldy x1
005202r 2  84 02          sty x2
005204r 2  20 rr rr       jsr getSlope1
005207r 2  85 00          sta x1
005209r 2               
005209r 2  A0 04          ldy #4
00520Br 2               tansearch:
00520Br 2  D9 rr rr       cmp tantable-1,y
00520Er 2  B0 03          bcs foundTan
005210r 2  88             dey
005211r 2  D0 F8          bne tansearch
005213r 2               foundTan:
005213r 2  98             tya
005214r 2  85 01          sta y1
005216r 2               
005216r 2  46 04          lsr flags
005218r 2  90 04          bcc noUndoDiagonal
00521Ar 2  49 FF          eor #$FF  ; reverse-subtract 8
00521Cr 2  69 08          adc #8
00521Er 2               noUndoDiagonal:
00521Er 2               
00521Er 2  46 04          lsr flags
005220r 2  B0 04          bcs noUndoHorizontal
005222r 2  49 FF          eor #$FF  ; reverse-subtract 16
005224r 2  69 11          adc #17   ; plus one because we came in with clc
005226r 2               noUndoHorizontal:
005226r 2               
005226r 2  46 04          lsr flags
005228r 2  B0 04          bcs noUndoVertical
00522Ar 2  49 FF          eor #$FF  ; reverse-subtract 32
00522Cr 2  69 21          adc #33   ; plus one because we came in with clc
00522Er 2               noUndoVertical:
00522Er 2               
00522Er 2  C9 20          cmp #32   ; fixes a bug where it tries to get a value past the end of the table
005230r 2  90 02          bcc :+
005232r 2  A9 00          lda #0
005234r 2  60           : rts
005235r 2               .endproc
005235r 2               
005235r 2               ; Tangents of angles between the ordinary angles, used by getAngle.
005235r 2               ; you can make trig tables even in windows calculator
005235r 2               ; (90/16*1)t*256= 25
005235r 2               tantable:
005235r 2  19 4E 89 D2    .byt 25, 78, 137, 210
005239r 2               
005239r 2               ; Accurate sin/cos table used by measureFromSilo.
005239r 2               ; These are indexed by angle in quadrant 1, and scaled by 256.
005239r 2               ; (90*7/8)s*256=
005239r 2               sine256Q1:
005239r 2  00 32 62 8E    .byt 0, 50, 98, 142, 181, 213, 237, 251
00523Dr 2  B5 D5 ED FB  
005241r 2               cosine256Q1:
005241r 2  00 FB ED D5    .byt  0, 251, 237, 213, 181, 142, 98, 50
005245r 2  B5 8E 62 32  
005249r 2               
005249r 2               ; Less precise sin/cos table used by e.g. missile smoke generation.
005249r 2               ; These are indexed by angle through the whole circle
005249r 2               ; and scaled by 64.
005249r 2               ; (90*7/8)s*64=
005249r 2               SineTable:
005249r 2  00 0C 18 24    .byt   0, 12, 24, 36, 45, 53, 59, 63
00524Dr 2  2D 35 3B 3F  
005251r 2               CosineTable:
005251r 2  40 3F 3B 35    .byt  64, 63, 59, 53, 45, 36, 24, 12
005255r 2  2D 24 18 0C  
005259r 2  00 F4 E8 DC    .byt   0,<-12,<-24,<-36,<-45,<-53,<-59,<-63
00525Dr 2  D3 CB C5 C1  
005261r 2  C0 C1 C5 CB    .byt <-64,<-63,<-59,<-53,<-45,<-36,<-24,<-12
005265r 2  D3 DC E8 F4  
005269r 2  00 0C 18 24    .byt   0, 12, 24, 36, 45, 53, 59, 63
00526Dr 2  2D 35 3B 3F  
005271r 2               
005271r 2               
005271r 1               .include "unpb53.s"
005271r 2               ;
005271r 2               ; PB53 unpacker for 6502 systems
005271r 2               ; Copyright 2012 Damian Yerrick
005271r 2               ;
005271r 2               ; Copying and distribution of this file, with or without
005271r 2               ; modification, are permitted in any medium without royalty provided
005271r 2               ; the copyright notice and this notice are preserved in all source
005271r 2               ; code copies.  This file is offered as-is, without any warranty.
005271r 2               ;
005271r 2               ;.export unpb53_some, PB53_outbuf, interbank_fetch, interbank_fetch_buf
005271r 2               ;.exportzp ciSrc, ciDst, ciBufStart, ciBufEnd
005271r 2               
005271r 2               .segment "ZEROPAGE"
0000E5r 2  xx xx        ciSrc: .res 2
0000E7r 2  xx xx        ciDst: .res 2
0000E9r 2  xx           ciBufStart: .res 1
0000EAr 2  xx           ciBufEnd: .res 1
0000EBr 2               PB53_outbuf = $0200
0000EBr 2               
0000EBr 2               ; the decompressor is less than 176 bytes, useful for loading into
0000EBr 2               ; RAM with a trampoline
0000EBr 2               .segment "CODE"
005271r 2               .proc unpb53_some
005271r 2               ctrlbyte = 0
005271r 2               bytesLeft = 1
005271r 2  A6 rr          ldx ciBufStart
005273r 2               loop:
005273r 2  A0 00          ldy #0
005275r 2  B1 rr          lda (ciSrc),y
005277r 2  E6 rr          inc ciSrc
005279r 2  D0 02          bne :+
00527Br 2  E6 rr          inc ciSrc+1
00527Dr 2               :
00527Dr 2  C9 82          cmp #$82
00527Fr 2  90 3A          bcc twoPlanes
005281r 2  F0 1E          beq copyLastTile
005283r 2  C9 84          cmp #$84
005285r 2  B0 28          bcs solidColor
005287r 2               
005287r 2                 ; at this point we're copying from the first stream to this one
005287r 2                 ; assuming that we're decoding two streams in parallel and the
005287r 2                 ; first stream's decompression buffer is PB53_outbuf[0:ciBufStart]
005287r 2  8A             txa
005288r 2  38             sec
005289r 2  E5 rr          sbc ciBufStart
00528Br 2  A8             tay
00528Cr 2               copyTile_ytox:
00528Cr 2  A9 10          lda #16
00528Er 2  85 01          sta bytesLeft
005290r 2               prevStreamLoop:
005290r 2  B9 00 02       lda PB53_outbuf,y
005293r 2  9D 00 02       sta PB53_outbuf,x
005296r 2  E8             inx
005297r 2  C8             iny
005298r 2  C6 01          dec bytesLeft
00529Ar 2  D0 F4          bne prevStreamLoop
00529Cr 2               tileDone:
00529Cr 2  E4 rr          cpx ciBufEnd
00529Er 2  90 D3          bcc loop
0052A0r 2  60             rts
0052A1r 2               
0052A1r 2               copyLastTile:
0052A1r 2  8A             txa
0052A2r 2  C5 rr          cmp ciBufStart
0052A4r 2  D0 02          bne notAtStart
0052A6r 2  A5 rr          lda ciBufEnd
0052A8r 2               notAtStart:
0052A8r 2  38             sec
0052A9r 2  E9 10          sbc #16
0052ABr 2  A8             tay
0052ACr 2  4C rr rr       jmp copyTile_ytox
0052AFr 2               
0052AFr 2               solidColor:
0052AFr 2  48             pha
0052B0r 2  20 rr rr       jsr solidPlane
0052B3r 2  68             pla
0052B4r 2  4A             lsr a
0052B5r 2  20 rr rr       jsr solidPlane
0052B8r 2  4C rr rr       jmp tileDone
0052BBr 2               
0052BBr 2               twoPlanes:
0052BBr 2  20 rr rr       jsr onePlane
0052BEr 2  A0 00          ldy #0
0052C0r 2  B1 rr          lda (ciSrc),y
0052C2r 2  E6 rr          inc ciSrc
0052C4r 2  D0 02          bne :+
0052C6r 2  E6 rr          inc ciSrc+1
0052C8r 2               :
0052C8r 2  C9 82          cmp #$82
0052CAr 2  B0 06          bcs copyPlane0to1
0052CCr 2  20 rr rr       jsr onePlane
0052CFr 2  4C rr rr       jmp tileDone
0052D2r 2               
0052D2r 2               copyPlane0to1:
0052D2r 2  A0 08          ldy #8
0052D4r 2  29 01          and #$01
0052D6r 2  F0 02          beq noInvertPlane0
0052D8r 2  A9 FF          lda #$FF
0052DAr 2               noInvertPlane0:
0052DAr 2  85 00          sta ctrlbyte
0052DCr 2               copyPlaneLoop:
0052DCr 2  BD F8 01       lda a:PB53_outbuf-8,x
0052DFr 2  45 00          eor ctrlbyte
0052E1r 2  9D 00 02       sta PB53_outbuf,x
0052E4r 2  E8             inx
0052E5r 2  88             dey
0052E6r 2  D0 F4          bne copyPlaneLoop
0052E8r 2  4C rr rr       jmp tileDone
0052EBr 2               
0052EBr 2               onePlane:
0052EBr 2  09 00          ora #$00
0052EDr 2  10 10          bpl pb8Plane
0052EFr 2               solidPlane:
0052EFr 2  A0 08          ldy #8
0052F1r 2  29 01          and #$01
0052F3r 2  F0 02          beq solidLoop
0052F5r 2  A9 FF          lda #$FF
0052F7r 2               solidLoop:
0052F7r 2  9D 00 02       sta PB53_outbuf,x
0052FAr 2  E8             inx
0052FBr 2  88             dey
0052FCr 2  D0 F9          bne solidLoop
0052FEr 2  60             rts
0052FFr 2               
0052FFr 2               pb8Plane:
0052FFr 2  38             sec
005300r 2  2A             rol a
005301r 2  85 00          sta ctrlbyte
005303r 2  A9 00          lda #$00
005305r 2               pb8loop:
005305r 2               
005305r 2                 ; at this point:
005305r 2                 ; A: previous byte in this plane
005305r 2                 ; C = 0: copy byte from bitstream
005305r 2                 ; C = 1: repeat previous byte
005305r 2  B0 03          bcs noNewByte
005307r 2  B1 rr          lda (ciSrc),y
005309r 2  C8             iny
00530Ar 2               noNewByte:
00530Ar 2  9D 00 02       sta PB53_outbuf,x
00530Dr 2  E8             inx
00530Er 2  06 00          asl ctrlbyte
005310r 2  D0 F3          bne pb8loop
005312r 2  18             clc
005313r 2  98             tya
005314r 2  65 rr          adc ciSrc
005316r 2  85 rr          sta ciSrc
005318r 2  90 02          bcc :+
00531Ar 2  E6 rr          inc ciSrc+1
00531Cr 2               :
00531Cr 2  60             rts
00531Dr 2               .endproc
00531Dr 2               
00531Dr 1               .include "attract.s"
00531Dr 2               StartAttract:
00531Dr 2  A9 45          lda #69
00531Fr 2  85 rr          sta r_seed
005321r 2  85 rr          sta random1+0
005323r 2  85 rr          sta random1+1
005325r 2  85 rr          sta random2+0
005327r 2  85 rr          sta random2+1
005329r 2               
005329r 2  A9 00          lda #0
00532Br 2  85 rr          sta LevelNumber
00532Dr 2  85 rr          sta PlayerEnabled+1
00532Fr 2  A9 01          lda #1
005331r 2  85 rr          sta PlayerEnabled
005333r 2  85 rr          sta AttractMode
005335r 2  8D rr rr       sta JustPickedFromMenu
005338r 2  4C rr rr       jmp NewGame
00533Br 2               
00533Br 1               
00533Br 1               .include "musicseq.h"
00533Br 2               ; Copyright 2010 Damian Yerrick
00533Br 2               ;
00533Br 2               ; Copying and distribution of this file, with or without
00533Br 2               ; modification, are permitted in any medium without royalty provided
00533Br 2               ; the copyright notice and this notice are preserved in all source
00533Br 2               ; code copies.  This file is offered as-is, without any warranty.
00533Br 2               
00533Br 2               .global drumSFX, psg_sound_table
00533Br 2               .global musicPatternTable, instrumentTable, songTable
00533Br 2               
00533Br 2               N_C  =  0*8
00533Br 2               N_CS =  1*8
00533Br 2               N_D  =  2*8
00533Br 2               N_DS =  3*8
00533Br 2               N_E  =  4*8
00533Br 2               N_F  =  5*8
00533Br 2               N_FS =  6*8
00533Br 2               N_G  =  7*8
00533Br 2               N_GS =  8*8
00533Br 2               N_A  =  9*8
00533Br 2               N_AS = 10*8
00533Br 2               N_B  = 11*8
00533Br 2               N_DB = N_CS
00533Br 2               N_EB = N_DS
00533Br 2               N_GB = N_FS
00533Br 2               N_AB = N_GS
00533Br 2               N_BB = N_AS
00533Br 2               N_CH  = N_C  + 12*8
00533Br 2               N_CSH = N_CS + 12*8
00533Br 2               N_DBH = N_DB + 12*8
00533Br 2               N_DH  = N_D  + 12*8
00533Br 2               N_DSH = N_DS + 12*8
00533Br 2               N_EBH = N_EB + 12*8
00533Br 2               N_EH  = N_E  + 12*8
00533Br 2               N_FH  = N_F  + 12*8
00533Br 2               N_FSH = N_FS + 12*8
00533Br 2               N_GBH = N_GB + 12*8
00533Br 2               N_GH  = N_G  + 12*8
00533Br 2               N_GSH = N_GS + 12*8
00533Br 2               N_ABH = N_AB + 12*8
00533Br 2               N_AH  = N_A  + 12*8
00533Br 2               N_ASH = N_AS + 12*8
00533Br 2               N_BBH = N_BB + 12*8
00533Br 2               N_BH  = N_B  + 12*8
00533Br 2               N_CHH = N_CH + 12*8
00533Br 2               N_TIE = 25*8
00533Br 2               REST  = 26*8
00533Br 2               INSTRUMENT = $D8
00533Br 2               
00533Br 2               ; The default duration is one row (a sixteenth note in the tracker).
00533Br 2               ; OR the pitch with one of these constants.
00533Br 2               D_8  = 1
00533Br 2               D_D8 = 2
00533Br 2               D_4  = 3
00533Br 2               D_D4 = 4
00533Br 2               D_2  = 5
00533Br 2               D_D2 = 6
00533Br 2               D_1  = 7
00533Br 2               
00533Br 2               CON_PLAYPAT = $00   ; next: pattern, transpose (if not drums), instrument (if not drums)
00533Br 2               CON_LOOPPAT = $10   ; as CON_PLAYPAT
00533Br 2               CON_WAITROWS = $20  ; next: number of rows to wait minus 1
00533Br 2               CON_FINE = $21      ; stop music now
00533Br 2               CON_SEGNO = $22     ; set loop point
00533Br 2               CON_DALSEGNO = $23  ; jump to loop point. if no point was set, jump to start of song.
00533Br 2               CON_SETTEMPO = $30  ; low bits: bits 8-9 of tempo in rows/min; next: bits 0-7 of tempo
00533Br 2               
00533Br 2               ; Conductor macros
00533Br 2               .macro playPatSq1 patid, transpose, instrument
00533Br 2                 .byt CON_PLAYPAT|0, patid, transpose, instrument
00533Br 2               .endmacro
00533Br 2               .macro playPatSq2 patid, transpose, instrument
00533Br 2                 .byt CON_PLAYPAT|1, patid, transpose, instrument
00533Br 2               .endmacro
00533Br 2               .macro playPatTri patid, transpose, instrument
00533Br 2                 .byt CON_PLAYPAT|2, patid, transpose, instrument
00533Br 2               .endmacro
00533Br 2               .macro playPatNoise patid, transpose, instrument
00533Br 2                 .byt CON_PLAYPAT|3, patid, transpose, instrument
00533Br 2               .endmacro
00533Br 2               .macro stopPatSq1
00533Br 2                 .byt CON_PLAYPAT|0, 255, 0, 0
00533Br 2               .endmacro
00533Br 2               .macro stopPatSq2
00533Br 2                 .byt CON_PLAYPAT|1, 255, 0, 0
00533Br 2               .endmacro
00533Br 2               .macro stopPatTri
00533Br 2                 .byt CON_PLAYPAT|2, 255, 0, 0
00533Br 2               .endmacro
00533Br 2               .macro stopPatNoise
00533Br 2                 .byt CON_PLAYPAT|3, 255, 0, 0
00533Br 2               .endmacro
00533Br 2               .macro waitRows n
00533Br 2                 .byt CON_WAITROWS, n-1
00533Br 2               .endmacro
00533Br 2               .macro fine
00533Br 2                 .byt CON_FINE
00533Br 2               .endmacro
00533Br 2               .macro segno
00533Br 2                 .byt CON_SEGNO
00533Br 2               .endmacro
00533Br 2               .macro dalSegno
00533Br 2                 .byt CON_DALSEGNO
00533Br 2               .endmacro
00533Br 2               .macro setTempo rowsPerMin
00533Br 2                 .byt CON_SETTEMPO|>rowsPerMin, <rowsPerMin
00533Br 2               .endmacro
00533Br 2               
00533Br 2               
00533Br 1               .include "sound.s"
00533Br 2               ; sound.s
00533Br 2               ; part of sound engine for LJ65, Concentration Room, and Thwaite
00533Br 2               
00533Br 2               ;;; Copyright (C) 2009-2011 Damian Yerrick
00533Br 2               ;
00533Br 2               ;   This program is free software; you can redistribute it and/or
00533Br 2               ;   modify it under the terms of the GNU General Public License
00533Br 2               ;   as published by the Free Software Foundation; either version 3
00533Br 2               ;   of the License, or (at your option) any later version.
00533Br 2               ;
00533Br 2               ;   This program is distributed in the hope that it will be useful,
00533Br 2               ;   but WITHOUT ANY WARRANTY; without even the implied warranty of
00533Br 2               ;   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
00533Br 2               ;   GNU General Public License for more details.
00533Br 2               ;
00533Br 2               ;   You should have received a copy of the GNU General Public License
00533Br 2               ;   along with this program; if not, write to
00533Br 2               ;     Free Software Foundation, Inc., 59 Temple Place - Suite 330,
00533Br 2               ;     Boston, MA  02111-1307, USA.
00533Br 2               ;
00533Br 2               ;   Visit http://www.pineight.com/ for more information.
00533Br 2               
00533Br 2               ;.import periodTableLo, periodTableHi
00533Br 2               ;.importzp psg_sfx_state  ; a 32 byte buffer in zp?
00533Br 2               ;.import update_music, update_music_ch, music_playing, psg_sound_table
00533Br 2               ;.export init_sound, start_sound, update_sound, soundBSS
00533Br 2               
00533Br 2               SNDCHN = $4015
00533Br 2               
00533Br 2               ; Ordinarily, the effect engine will move a pulse sound effect from
00533Br 2               ; $4000 to $4004 if $4004 is idle and $4000 is not, or if $4004 has
00533Br 2               ; less sfx data left to play than $4000.  Turn this off to force all
00533Br 2               ; pulse sfx to be played on $4000.
00533Br 2               SQUARE_POOLING = 1
00533Br 2               
00533Br 2               ; As of 2011-03-10, a sound effect interrupts a musical instrument on
00533Br 2               ; the same channel only if the volume of the sfx is greater than that
00533Br 2               ; of the instrument.  Turn this off to force sound fx to interrupt
00533Br 2               ; the music whenever sfx data remains on that channel, even if the
00533Br 2               ; music is louder.
00533Br 2               KEEP_MUSIC_IF_LOUDER = 1
00533Br 2               
00533Br 2               ;.segment "BSS"
00533Br 2               
00533Br 2               
00533Br 2               psg_sfx_datalo = psg_sfx_state + 0
00533Br 2               psg_sfx_datahi = psg_sfx_state + 1
00533Br 2               psg_sfx_lastfreqhi = psg_sfx_state + 18
00533Br 2               psg_sfx_remainlen = psg_sfx_state + 19
00533Br 2               psg_sfx_rate = soundBSS + 3
00533Br 2               psg_sfx_ratecd = soundBSS + 19
00533Br 2               
00533Br 2               ;.ifndef SOUND_NTSC_ONLY
00533Br 2               ;SOUND_NTSC_ONLY = 0
00533Br 2               ;.endif
00533Br 2               ;.if (!SOUND_NTSC_ONLY)
00533Br 2               ;.importzp tvSystem
00533Br 2               ;.endif
00533Br 2               
00533Br 2               .segment "CODE"
00533Br 2               
00533Br 2               ;;
00533Br 2               ; Initializes all sound channels.
00533Br 2               ; Use it at the start of a program or as a "panic button" before
00533Br 2               ; entering a long stretch of code where you don't update_sound.
00533Br 2               ;
00533Br 2               .proc init_sound
00533Br 2  A9 0F          lda #$0F
00533Dr 2  8D 15 40       sta SNDCHN
005340r 2  A9 30          lda #$30
005342r 2  8D 00 40       sta $4000
005345r 2  8D 04 40       sta $4004
005348r 2  8D 0C 40       sta $400C
00534Br 2  85 rr          sta psg_sfx_lastfreqhi+0
00534Dr 2  85 rr          sta psg_sfx_lastfreqhi+8
00534Fr 2  85 rr          sta psg_sfx_lastfreqhi+4
005351r 2  A9 80          lda #$80
005353r 2  8D 08 40       sta $4008
005356r 2  A9 08          lda #8
005358r 2  8D 01 40       sta $4001
00535Br 2  8D 05 40       sta $4005
00535Er 2  A9 00          lda #0
005360r 2  8D 03 40       sta $4003
005363r 2  8D 07 40       sta $4007
005366r 2  8D 0F 40       sta $400F
005369r 2  85 rr          sta psg_sfx_remainlen+0
00536Br 2  85 rr          sta psg_sfx_remainlen+4
00536Dr 2  85 rr          sta psg_sfx_remainlen+8
00536Fr 2  85 rr          sta psg_sfx_remainlen+12
005371r 2  8D rr rr       sta music_playing
005374r 2  A9 40          lda #64
005376r 2  8D 11 40       sta $4011
005379r 2  60             rts
00537Ar 2               .endproc
00537Ar 2               
00537Ar 2               ;;
00537Ar 2               ; Starts a sound effect.
00537Ar 2               ; (Trashes $0000-$0004 and Y. (Originally trashed X but X is too important))
00537Ar 2               ;
00537Ar 2               ; @param A sound effect number (0-63)
00537Ar 2               ;
00537Ar 2               .proc start_sound
00537Ar 2               snddatalo = 0
00537Ar 2               snddatahi = 1
00537Ar 2               sndchno = 2
00537Ar 2               sndlen = 3
00537Ar 2               sndrate = 4
00537Ar 2               
00537Ar 2  0A             asl a
00537Br 2  0A             asl a
00537Cr 2  A8             tay
00537Dr 2  B9 rr rr       lda psg_sound_table,y
005380r 2  85 00          sta snddatalo
005382r 2  B9 rr rr       lda psg_sound_table+1,y
005385r 2  85 01          sta snddatahi
005387r 2  B9 rr rr       lda psg_sound_table+2,y
00538Ar 2  29 0C          and #$0C
00538Cr 2  85 02          sta sndchno
00538Er 2  B9 rr rr       lda psg_sound_table+2,y
005391r 2  4A             lsr a
005392r 2  4A             lsr a
005393r 2  4A             lsr a
005394r 2  4A             lsr a
005395r 2  85 04          sta sndrate
005397r 2               
005397r 2  B9 rr rr       lda psg_sound_table+3,y
00539Ar 2  85 03          sta sndlen
00539Cr 2               
00539Cr 2                 ; split up square wave sounds between $4000 and $4004
00539Cr 2                 .if ::SQUARE_POOLING
00539Cr 2  A5 02            lda sndchno
00539Er 2  D0 0A            bne not_ch0to4  ; if not ch 0, don't try moving it
0053A0r 2  A5 rr              lda psg_sfx_remainlen+4
0053A2r 2  C5 rr              cmp psg_sfx_remainlen
0053A4r 2  B0 04              bcs not_ch0to4
0053A6r 2  A9 04              lda #4
0053A8r 2  85 02              sta sndchno
0053AAr 2                   not_ch0to4:
0053AAr 2                 .endif
0053AAr 2               
0053AAr 2  A4 02          ldy sndchno
0053ACr 2  A5 03          lda sndlen
0053AEr 2  D9 rr rr       cmp psg_sfx_remainlen,y
0053B1r 2  B0 01          bcs ch_not_full
0053B3r 2  60             rts
0053B4r 2               ch_not_full:
0053B4r 2               
0053B4r 2  A5 00          lda snddatalo
0053B6r 2  99 rr rr       sta psg_sfx_datalo,y
0053B9r 2  A5 01          lda snddatahi
0053BBr 2  99 rr rr       sta psg_sfx_datahi,y
0053BEr 2  A5 03          lda sndlen
0053C0r 2  99 rr rr       sta psg_sfx_remainlen,y
0053C3r 2  A5 04          lda sndrate
0053C5r 2  99 rr rr       sta psg_sfx_rate,y
0053C8r 2  A9 00          lda #0
0053CAr 2  99 rr rr       sta psg_sfx_ratecd,y
0053CDr 2  60             rts
0053CEr 2               .endproc
0053CEr 2               
0053CEr 2               
0053CEr 2               ;;
0053CEr 2               ; Updates sound effect channels.
0053CEr 2               ;
0053CEr 2               .proc update_sound
0053CEr 2  20 rr rr       jsr update_music
0053D1r 2  A2 0C          ldx #12
0053D3r 2               loop:
0053D3r 2  20 rr rr       jsr update_music_ch
0053D6r 2  20 rr rr       jsr update_one_ch
0053D9r 2  CA             dex
0053DAr 2  CA             dex
0053DBr 2  CA             dex
0053DCr 2  CA             dex
0053DDr 2  10 F4          bpl loop
0053DFr 2  60             rts
0053E0r 2               .endproc
0053E0r 2               
0053E0r 2               .proc update_one_ch
0053E0r 2               
0053E0r 2                 ; At this point, the music engine should have left duty and volume
0053E0r 2                 ; in 2 and pitch in 3.
0053E0r 2  B5 rr          lda psg_sfx_remainlen,x
0053E2r 2  D0 12          bne ch_not_done
0053E4r 2  A5 02          lda 2
0053E6r 2  D0 45          bne update_channel_hw
0053E8r 2               
0053E8r 2                 ; Turn off the channel and force a reinit of the length counter.
0053E8r 2  E0 08          cpx #8
0053EAr 2  F0 02          beq not_triangle_kill
0053ECr 2  A9 30            lda #$30
0053EEr 2                 not_triangle_kill:
0053EEr 2  9D 00 40       sta $4000,x
0053F1r 2  A9 FF          lda #$FF
0053F3r 2  95 rr          sta psg_sfx_lastfreqhi,x
0053F5r 2  60             rts
0053F6r 2               ch_not_done:
0053F6r 2               
0053F6r 2                 ; playback rate divider
0053F6r 2  DE rr rr       dec psg_sfx_ratecd,x
0053F9r 2  10 42          bpl rate_divider_cancel
0053FBr 2  BD rr rr       lda psg_sfx_rate,x
0053FEr 2  9D rr rr       sta psg_sfx_ratecd,x
005401r 2               
005401r 2                 ; fetch the instruction
005401r 2  B5 rr          lda psg_sfx_datalo+1,x
005403r 2  85 01          sta 1
005405r 2  B5 rr          lda psg_sfx_datalo,x
005407r 2  85 00          sta 0
005409r 2  18             clc
00540Ar 2  69 02          adc #2
00540Cr 2  95 rr          sta psg_sfx_datalo,x
00540Er 2  90 02          bcc :+
005410r 2  F6 rr          inc psg_sfx_datahi,x
005412r 2               :
005412r 2  A0 00          ldy #0
005414r 2                 .if ::KEEP_MUSIC_IF_LOUDER
005414r 2  A5 02            lda 2
005416r 2  29 0F            and #$0F
005418r 2  85 04            sta 4
00541Ar 2  B1 00            lda (0),y
00541Cr 2  29 0F            and #$0F
00541Er 2               
00541Er 2                   ; At this point: A = sfx volume; 4 = musc volume
00541Er 2  C5 04            cmp 4
005420r 2  90 09            bcc music_was_louder
005422r 2                 .endif
005422r 2  B1 00          lda (0),y
005424r 2  85 02          sta 2
005426r 2  C8             iny
005427r 2  B1 00          lda (0),y
005429r 2  85 03          sta 3
00542Br 2               music_was_louder:
00542Br 2  D6 rr          dec psg_sfx_remainlen,x
00542Dr 2               
00542Dr 2               update_channel_hw:
00542Dr 2  A5 02          lda 2
00542Fr 2  09 30          ora #$30
005431r 2  E0 0C          cpx #12
005433r 2  D0 09          bne notnoise
005435r 2  8D 0C 40       sta $400C
005438r 2  A5 03          lda 3
00543Ar 2  8D 0E 40       sta $400E
00543Dr 2               rate_divider_cancel:
00543Dr 2  60             rts
00543Er 2               
00543Er 2               notnoise:
00543Er 2  9D 00 40       sta $4000,x
005441r 2  A4 03          ldy 3
005443r 2               ;.ifndef ::SOUND_NTSC_ONLY
005443r 2               ;  lda tvSystem
005443r 2               ;  beq :+
005443r 2               ;  iny
005443r 2               ;:
005443r 2               ;.endif
005443r 2  B9 rr rr       lda periodTableLo,y
005446r 2  9D 02 40       sta $4002,x
005449r 2  B9 rr rr       lda periodTableHi,y
00544Cr 2  D5 rr          cmp psg_sfx_lastfreqhi,x
00544Er 2  F0 05          beq no_change_to_hi_period
005450r 2  95 rr          sta psg_sfx_lastfreqhi,x
005452r 2  9D 03 40       sta $4003,x
005455r 2               no_change_to_hi_period:
005455r 2               
005455r 2  60             rts
005456r 2               .endproc
005456r 2               
005456r 2               periodTableLo:
005456r 2  F1 7F 13 AD    .byt $f1,$7f,$13,$ad,$4d,$f3,$9d,$4c,$00,$b8,$74,$34
00545Ar 2  4D F3 9D 4C  
00545Er 2  00 B8 74 34  
005462r 2  F8 BF 89 56    .byt $f8,$bf,$89,$56,$26,$f9,$ce,$a6,$80,$5c,$3a,$1a
005466r 2  26 F9 CE A6  
00546Ar 2  80 5C 3A 1A  
00546Er 2  FB DF C4 AB    .byt $fb,$df,$c4,$ab,$93,$7c,$67,$52,$3f,$2d,$1c,$0c
005472r 2  93 7C 67 52  
005476r 2  3F 2D 1C 0C  
00547Ar 2  FD EF E1 D5    .byt $fd,$ef,$e1,$d5,$c9,$bd,$b3,$a9,$9f,$96,$8e,$86
00547Er 2  C9 BD B3 A9  
005482r 2  9F 96 8E 86  
005486r 2  7E 77 70 6A    .byt $7e,$77,$70,$6a,$64,$5e,$59,$54,$4f,$4b,$46,$42
00548Ar 2  64 5E 59 54  
00548Er 2  4F 4B 46 42  
005492r 2  3F 3B 38 34    .byt $3f,$3b,$38,$34,$31,$2f,$2c,$29,$27,$25,$23,$21
005496r 2  31 2F 2C 29  
00549Ar 2  27 25 23 21  
00549Er 2  1F 1D 1B 1A    .byt $1f,$1d,$1b,$1a,$18,$17,$15,$14
0054A2r 2  18 17 15 14  
0054A6r 2               periodTableHi:
0054A6r 2  07 07 07 06    .byt $07,$07,$07,$06,$06,$05,$05,$05,$05,$04,$04,$04
0054AAr 2  06 05 05 05  
0054AEr 2  05 04 04 04  
0054B2r 2  03 03 03 03    .byt $03,$03,$03,$03,$03,$02,$02,$02,$02,$02,$02,$02
0054B6r 2  03 02 02 02  
0054BAr 2  02 02 02 02  
0054BEr 2  01 01 01 01    .byt $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
0054C2r 2  01 01 01 01  
0054C6r 2  01 01 01 01  
0054CAr 2  00 00 00 00    .byt $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
0054CEr 2  00 00 00 00  
0054D2r 2  00 00 00 00  
0054D6r 2  00 00 00 00    .byt $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
0054DAr 2  00 00 00 00  
0054DEr 2  00 00 00 00  
0054E2r 2  00 00 00 00    .byt $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
0054E6r 2  00 00 00 00  
0054EAr 2  00 00 00 00  
0054EEr 2  00 00 00 00    .byt $00,$00,$00,$00,$00,$00,$00,$00
0054F2r 2  00 00 00 00  
0054F6r 2               
0054F6r 1               .include "music.s"
0054F6r 2               ; music.s
0054F6r 2               ; part of sound engine for LJ65, Concentration Room, and Thwaite
0054F6r 2               
0054F6r 2               ;;; Copyright (C) 2009-2011 Damian Yerrick
0054F6r 2               ;
0054F6r 2               ;   This program is free software; you can redistribute it and/or
0054F6r 2               ;   modify it under the terms of the GNU General Public License
0054F6r 2               ;   as published by the Free Software Foundation; either version 3
0054F6r 2               ;   of the License, or (at your option) any later version.
0054F6r 2               ;
0054F6r 2               ;   This program is distributed in the hope that it will be useful,
0054F6r 2               ;   but WITHOUT ANY WARRANTY; without even the implied warranty of
0054F6r 2               ;   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
0054F6r 2               ;   GNU General Public License for more details.
0054F6r 2               ;
0054F6r 2               ;   You should have received a copy of the GNU General Public License
0054F6r 2               ;   along with this program; if not, write to
0054F6r 2               ;     Free Software Foundation, Inc., 59 Temple Place - Suite 330,
0054F6r 2               ;     Boston, MA  02111-1307, USA.
0054F6r 2               ;
0054F6r 2               ;   Visit http://www.pineight.com/ for more information.
0054F6r 2               
0054F6r 2               ;.importzp psg_sfx_state
0054F6r 2               ;.import soundBSS
0054F6r 2               ;.import start_sound
0054F6r 2               ;.export music_playing
0054F6r 2               ;.export init_music, stop_music, update_music, update_music_ch
0054F6r 2               ;.include "musicseq.h"
0054F6r 2               
0054F6r 2               ;.ifndef SOUND_NTSC_ONLY
0054F6r 2               ;SOUND_NTSC_ONLY = 0
0054F6r 2               ;.endif
0054F6r 2               ;.if (!SOUND_NTSC_ONLY)
0054F6r 2               ;.importzp tvSystem
0054F6r 2               ;.endif
0054F6r 2               
0054F6r 2               musicPatternPos = psg_sfx_state + 2
0054F6r 2               conductorPos = psg_sfx_state + 16
0054F6r 2               noteEnvVol = soundBSS + 0
0054F6r 2               notePitch = soundBSS + 1
0054F6r 2               noteRowsLeft = soundBSS + 2
0054F6r 2               ; 3 is in sound.s
0054F6r 2               musicPattern = soundBSS + 16
0054F6r 2               patternTranspose = soundBSS + 17
0054F6r 2               noteInstrument = soundBSS + 18
0054F6r 2               ; 19 is in sound.s
0054F6r 2               tempoCounterLo = soundBSS + 48
0054F6r 2               tempoCounterHi = soundBSS + 49
0054F6r 2               music_tempoLo = soundBSS + 50
0054F6r 2               music_tempoHi = soundBSS + 51
0054F6r 2               conductorSegno = soundBSS + 52
0054F6r 2               
0054F6r 2               conductorWaitRows = soundBSS + 62
0054F6r 2               music_playing = soundBSS + 63
0054F6r 2               
0054F6r 2               FRAMES_PER_MINUTE_PAL = 3000
0054F6r 2               FRAMES_PER_MINUTE_NTSC = 3606
0054F6r 2               
0054F6r 2               
0054F6r 2               ;.segment "RODATA"
0054F6r 2               
0054F6r 2               fpmLo:
0054F6r 2  16 B8          .byt <FRAMES_PER_MINUTE_NTSC, <FRAMES_PER_MINUTE_PAL
0054F8r 2               fpmHi:
0054F8r 2  0E 0B          .byt >FRAMES_PER_MINUTE_NTSC, >FRAMES_PER_MINUTE_PAL
0054FAr 2               
0054FAr 2               silentPattern:
0054FAr 2  D7 FF          .byt 26*8+7, 255
