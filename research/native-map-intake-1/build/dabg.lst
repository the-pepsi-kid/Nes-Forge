004210r 2               .proc ClearOAM
004210r 2  A9 F0          lda #<-16
004212r 2  A2 00          ldx #0
004214r 2  9D 00 02     : sta OAM_YPOS,x
004217r 2  E8             inx
004218r 2  E8             inx
004219r 2  E8             inx
00421Ar 2  E8             inx
00421Br 2  D0 F7          bne :-
00421Dr 2  60             rts
00421Er 2               .endproc
00421Er 2               
00421Er 2               ;http://codebase64.org/doku.php?id=base:two_very_fast_16bit_pseudo_random_generators_as_lfsr
00421Er 2               .proc huge_rand
00421Er 2  20 rr rr       jsr rand64k       ;Factors of 65535: 3 5 17 257
004221r 2  20 rr rr       jsr rand32k       ;Factors of 32767: 7 31 151 are independent and can be combined
004224r 2               ;  lda random1+1        ;can be left out
004224r 2               ;  eor random2+1        ;if you dont use
004224r 2               ;  tay                  ;y as suggested
004224r 2  A5 rr          lda random1           ;mix up lowbytes of random1
004226r 2  45 rr          eor random2           ;and random2 to combine both
004228r 2  60             rts
004229r 2               .endproc
004229r 2               
004229r 2               ;periode with 65535
004229r 2               ;10+12+13+15
004229r 2               .proc rand64k
004229r 2  A5 rr          lda random1+1
00422Br 2  0A             asl
00422Cr 2  0A             asl
00422Dr 2  45 rr          eor random1+1
00422Fr 2  0A             asl
004230r 2  45 rr          eor random1+1
004232r 2  0A             asl
004233r 2  0A             asl
004234r 2  45 rr          eor random1+1
004236r 2  0A             asl
004237r 2  26 rr          rol random1         ;shift this left, "random" bit comes from low
004239r 2  26 rr          rol random1+1
00423Br 2  60             rts
00423Cr 2               .endproc
00423Cr 2               
00423Cr 2               ;periode with 32767
00423Cr 2               ;13+14
00423Cr 2               .proc rand32k
00423Cr 2  A5 rr          lda random2+1
00423Er 2  0A             asl
00423Fr 2  45 rr          eor random2+1
004241r 2  0A             asl
004242r 2  0A             asl
004243r 2  66 rr          ror random2         ;shift this right, random bit comes from high - nicer when eor with random1
004245r 2  26 rr          rol random2+1
004247r 2  60             rts
004248r 2               .endproc
004248r 2               
004248r 2               .if 0
004248r 2               .proc CopyFromCHR ; A: <address, X: >address - outputs to $500
004248r 2                 stx PPUADDR
004248r 2                 sta PPUADDR
004248r 2                 lda PPUDATA ; dummy read
004248r 2               
004248r 2                 ldy #0      ; prepare destination address (always $500)
004248r 2                 sty 0
004248r 2                 lda #5
004248r 2                 sta 1
004248r 2               
004248r 2                 ldx PPUDATA ; read size low
004248r 2                 lda PPUDATA ; read size high
004248r 2                 sta 2
004248r 2                 inc 2
004248r 2               
004248r 2               Loop:
004248r 2                 lda PPUDATA
004248r 2                 sta (0),y
004248r 2                 iny
004248r 2                 bne :+      ; fix destination address if we roll over
004248r 2                   inc 1
004248r 2                 :
004248r 2                 dex
004248r 2                 cpx #-1     ; fix size if we roll over
004248r 2                 bne :+
004248r 2                   lda 2
004248r 2                   beq Exit
004248r 2                   dec 2
004248r 2                   bmi Exit
004248r 2                 :
004248r 2                 bne Loop
004248r 2               Exit:
004248r 2                 rts
004248r 2               .endproc
004248r 2               .endif
