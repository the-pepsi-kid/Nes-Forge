000CC9r 2               .proc ChkTouchGeneric
000CC9r 2                 ; http://atariage.com/forums/topic/71120-6502-killer-hacks/page-3?&#entry1054049
000CC9r 2               ; X positions
000CC9r 2  A5 rr          lda TouchWidthB
000CCBr 2  38 E9 01       sub #1
000CCEr 2  85 rr          sta TouchTemp
000CD0r 2  18 65 rr       add TouchWidthA
000CD3r 2  85 rr          sta TouchTemp2  ; carry now set
000CD5r 2               
000CD5r 2  A5 rr          lda TouchLeftA
000CD7r 2  E5 rr          sbc TouchLeftB ; Note will subtract n-1
000CD9r 2  E5 rr          sbc TouchTemp  ;#SIZE2-1
000CDBr 2  65 rr          adc TouchTemp2 ;#SIZE1+SIZE2-1 ; Carry set if overlap
000CDDr 2  90 18          bcc No
000CDFr 2               
000CDFr 2               ; Y positions
000CDFr 2  A5 rr          lda TouchHeightB
000CE1r 2  38 E9 01       sub #1
000CE4r 2  85 rr          sta TouchTemp
000CE6r 2  18 65 rr       add TouchHeightA
