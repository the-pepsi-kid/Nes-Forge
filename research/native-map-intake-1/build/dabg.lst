0000B4r 2               .proc ReadJoyOnce
0000B4r 2  A9 01          lda #1
0000B6r 2  8D rr rr       sta keydown+3
0000B9r 2  AD 16 40     : lda JOY1
0000BCr 2  29 03          and #$03
0000BEr 2  C9 01          cmp #1
0000C0r 2  2E rr rr       rol keydown+2
0000C3r 2  AD 17 40       lda JOY2
0000C6r 2  29 03          and #$03
0000C8r 2  C9 01          cmp #1
0000CAr 2  2E rr rr       rol keydown+3
0000CDr 2  90 EA          bcc :-
0000CFr 2  60             rts
0000D0r 2               .endproc
0000D0r 2               .endif
