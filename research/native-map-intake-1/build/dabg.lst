001777r 2               .proc EnemyPlayerTouch
001777r 2  A0 00          ldy #0
001779r 2               PlayerLoop:
001779r 2  B9 rr rr       lda PlayerPX,y
00177Cr 2  85 rr          sta TouchLeftA
00177Er 2  B9 rr rr       lda PlayerPYH,y
001781r 2  85 rr          sta TouchTopA
001783r 2               
001783r 2  BD rr rr       lda ObjectPX,x
001786r 2  85 rr          sta TouchLeftB
001788r 2  BD rr rr       lda ObjectPYH,x
00178Br 2  85 rr          sta TouchTopB
00178Dr 2               
00178Dr 2  A5 rr          lda EnemyWidth
00178Fr 2  85 rr          sta TouchWidthB
001791r 2  A9 08          lda #8
001793r 2  85 rr          sta TouchWidthA
001795r 2  0A             asl
001796r 2  85 rr          sta TouchHeightA
001798r 2  85 rr          sta TouchHeightB
00179Ar 2               
00179Ar 2  20 rr rr       jsr ChkTouchGeneric
00179Dr 2  90 09          bcc NotTouched
00179Fr 2  BD rr rr         lda ObjectF2,x
0017A2r 2  C9 02            cmp #ENEMY_STATE_STUNNED
0017A4r 2  F0 08            beq IsStunned
0017A6r 2  D0 29            bne IsNotStunned
0017A8r 2               NotTouched:
0017A8r 2  C8             iny
0017A9r 2  C0 04          cpy #MaxNumPlayers
0017ABr 2  D0 CC          bne PlayerLoop
0017ADr 2  60             rts
0017AEr 2               IsStunned:
0017AEr 2                 ; award points for removing the enemy
0017AEr 2  86 rr          stx TempVal+2
0017B0r 2  84 rr          sty TempVal+3
0017B2r 2  BD rr rr       lda ObjectF1,x ; get the enemy type number from the flags
0017B5r 2  29 3E 4A       alr #%111110
0017B8r 2  A8             tay
0017B9r 2  B9 rr rr       lda ObjectPointsTable,y
0017BCr 2  A6 rr          ldx TempVal+3
0017BEr 2  20 rr rr       jsr PlayerAddScore
0017C1r 2               
0017C1r 2  A9 07          lda #SOUND_COLLECT
0017C3r 2  20 rr rr       jsr start_sound
0017C6r 2  A6 rr          ldx TempVal+2
0017C8r 2  A4 rr          ldy TempVal+3
0017CAr 2  18             clc
0017CBr 2  20 rr rr       jsr EnemyKill
0017CEr 2  4C rr rr       jmp NotTouched
0017D1r 2               IsNotStunned:
0017D1r 2  A5 rr          lda EnemyWidth ; wide enemies always hurt
0017D3r 2  C9 08          cmp #8
0017D5r 2  F0 0F          beq :+
0017D7r 2  BD rr rr         lda ObjectF1,x ; unless it's a Goomba then you can stomp it
0017DAr 2  29 3E 4A         alr #%111110
0017DDr 2  C9 09            cmp #OBJECT_GOOMBA
0017DFr 2  F0 11            beq Goomba
0017E1r 2  20 rr rr         jsr PlayerHurt
0017E4r 2  D0 C2            bne NotTouched
0017E6r 2  A5 rr        : lda GameDifficulty
0017E8r 2  C9 01          cmp #DIFFICULTY_HARDER
0017EAr 2  90 BC          bcc NotTouched
0017ECr 2               HurtPlayer:
0017ECr 2  20 rr rr       jsr PlayerHurt
0017EFr 2  4C rr rr       jmp NotTouched
0017F2r 2               
0017F2r 2               Goomba:
0017F2r 2  B9 rr rr       lda PlayerVYH,y
0017F5r 2  30 F5          bmi HurtPlayer
0017F7r 2  C9 01          cmp #1
0017F9r 2  B0 B3          bcs IsStunned
0017FBr 2  B9 rr rr       lda PlayerVYL,y
0017FEr 2  D0 AE          bne IsStunned
001800r 2  F0 EA          beq HurtPlayer
001802r 2               .endproc
