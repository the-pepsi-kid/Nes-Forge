001074r 2               
001074r 2               .proc GenerateLevel
001074r 2  AD rr rr       lda LevelEditMode
001077r 2  F0 03 4C rr    jne JustFinishLevel
00107Br 2  rr           
00107Cr 2               
00107Cr 2  A9 00          lda #0
00107Er 2  8D rr rr       sta NumRowsMade
001081r 2  AA             tax
001082r 2  9D 00 07     : sta LevelBuf,x  ; clear buffer first
001085r 2  E8             inx
001086r 2  D0 FA          bne :-
001088r 2               
001088r 2                 ; if level specifies a map, don't make random platforms
001088r 2  AD rr rr       lda LevelConfigBytes+6
00108Br 2  F0 03 4C rr    jne EmptyMap
00108Fr 2  rr           
001090r 2               
001090r 2               ; if level specifies a map, and doesn't turn the composite bit on, clear first
001090r 2               ;  lda LevelConfigBytes+6
001090r 2               ;  beq :+
001090r 2               ;    lda LevelConfigBytes+1
001090r 2               ;    and #COMPOSITE_MAP
001090r 2               ;    jeq EmptyMap
001090r 2               ;  :
001090r 2               
001090r 2  A9 0C 85 00    .dj_loop #12, 0 ; zp0 = row count
001094r 2  20 rr rr         jsr rand_8
001097r 2  29 0C            and #%1100
001099r 2  F0 37            beq DontMakeRow
00109Br 2  EE rr rr         inc NumRowsMade
00109Er 2               
00109Er 2  A5 00            lda 0
0010A0r 2  C9 01            cmp #1
0010A2r 2  D0 03 4C rr      jeq DontMakeRow
0010A6r 2  rr           
0010A7r 2  0A 0A 0A 0A      .repeat 4
0010ABr 2                     asl
0010ABr 2                   .endrep
0010ABr 2  85 02            sta 2          ; zp2 = row pointer
0010ADr 2               
0010ADr 2  20 rr rr         jsr huge_rand
0010B0r 2  18               clc
0010B1r 2  6A               ror
0010B2r 2  6A               ror
0010B3r 2  6A               ror
0010B4r 2  29 0F            and #%00001111 ; pick random column to start from
0010B6r 2  05 02            ora 2
0010B8r 2  AA               tax
0010B9r 2               
0010B9r 2  A9 04 85 01      .dj_loop #4, 1 ; zp1 = ledge width count
0010BDr 2  A9 17              lda #METATILE_PLATFM
0010BFr 2  9D 00 07           sta LevelBuf,x
0010C2r 2               
0010C2r 2  8A                 txa      ; increment low nybble of X
0010C3r 2  29 F0              and #$f0
0010C5r 2  85 02              sta 2
0010C7r 2  E8                 inx
0010C8r 2  8A                 txa
0010C9r 2  29 0F              and #$0f
0010CBr 2  05 02              ora 2
0010CDr 2  AA                 tax
0010CEr 2  C6 01 D0 EB      .end_djl
0010D2r 2               
0010D2r 2                 DontMakeRow:
0010D2r 2  C6 00 D0 BE    .end_djl
0010D6r 2               
0010D6r 2  AD rr rr       lda NumRowsMade
0010D9r 2  C9 05          cmp #5
0010DBr 2  B0 03 4C rr    jcc GenerateLevel
0010DFr 2  rr           
0010E0r 2               
0010E0r 2  20 rr rr       jsr MakeBottomPlatforms
0010E3r 2               EmptyMap:
0010E3r 2  AD rr rr       lda LevelConfigBytes+7 ; if an address is present, decode the level it points to
0010E6r 2  F0 03          beq JustFinishLevel
0010E8r 2  20 rr rr       jsr DecodeLevelMap
0010EBr 2               JustFinishLevel:
0010EBr 2  20 rr rr       jsr PreLevelScreen
0010EEr 2  20 rr rr       jsr PrettyLevel
0010F1r 2  20 rr rr       jsr RenderLevelBuf
0010F4r 2  60             rts
0010F5r 2               .endproc
0010F5r 2               .proc MakeBottomPlatforms
0010F5r 2  A9 15          lda #METATILE_SOLID  ; make a run of blocks at the bottom
0010F7r 2  A2 00          ldx #0
0010F9r 2  9D E1 07     : sta LevelBuf + $E1,x
0010FCr 2  E8             inx
0010FDr 2  E0 0E          cpx #14
0010FFr 2  D0 F8          bne :-
001101r 2               
001101r 2  A5 rr          lda AttractMode
001103r 2  D0 08          bne :+
001105r 2  A9 00          lda #0              ; add in the two empty blocks in the very center
001107r 2  8D E7 07       sta LevelBuf + $E7
00110Ar 2  8D E8 07       sta LevelBuf + $E8
00110Dr 2  60           : rts
00110Er 2               .endproc
00110Er 2               
00110Er 2               .proc MakeClouds
00110Er 2  A9 0A 85 00    .dj_loop #10, 0
001112r 2  20 rr rr         jsr rand_8
001115r 2  4A               lsr
001116r 2  4A               lsr
001117r 2  AA               tax
001118r 2  29 0F            and #15
00111Ar 2  C9 0F            cmp #15
00111Cr 2  F0 19            beq NoGood
00111Er 2  8A               txa
00111Fr 2  38 E9 E0 AA      axs #<-32
001123r 2  BD 00 07         lda LevelBuf+0,x
001126r 2  D0 0F            bne NoGood
001128r 2  BD 01 07         lda LevelBuf+1,x
00112Br 2  D0 0A            bne NoGood
00112Dr 2  A9 05            lda #METATILE_CLOUDL
00112Fr 2  9D 00 07         sta LevelBuf+0,x
001132r 2  A9 06            lda #METATILE_CLOUDR
001134r 2  9D 01 07         sta LevelBuf+1,x
001137r 2               NoGood:
001137r 2  C6 00 D0 D7    .end_djl
00113Br 2  60             rts
00113Cr 2               .endproc
00113Cr 2               
00113Cr 2               IsGrassOrSolid: ; returns result in carry
00113Cr 2  C9 15          cmp #METATILE_SOLID
00113Er 2  F0 08          beq IsGrassOrSolid_Yes
001140r 2               TileIsGrass:
001140r 2  C9 1C          cmp #METATILE_GRASSL
001142r 2  90 06          bcc :+
001144r 2  C9 24          cmp #METATILE_DIRT_T+1
001146r 2  B0 02          bcs :+
001148r 2               IsGrassOrSolid_Yes:
001148r 2  38             sec
001149r 2  60             rts
00114Ar 2  18           : clc
00114Br 2  60             rts
00114Cr 2               
00114Cr 2               .proc GrassTryRow
00114Cr 2  A5 00          lda 0
00114Er 2  38 E9 10       sub #16
001151r 2  85 00          sta 0
001153r 2  AA             tax
001154r 2  E0 30          cpx #$30
001156r 2  90 21          bcc Exit
001158r 2  A5 01          lda 1
00115Ar 2  38 E9 10       sub #16
00115Dr 2  85 01          sta 1
00115Fr 2               Check:
00115Fr 2  BD 00 07       lda LevelBuf,x
001162r 2  C9 15          cmp #METATILE_SOLID
001164r 2  D0 13          bne Exit
001166r 2  E8             inx
001167r 2  E4 01          cpx 1
001169r 2  D0 F4          bne Check
00116Br 2               
00116Br 2  A6 00          ldx 0
00116Dr 2  A9 1D          lda #METATILE_GRASSM
00116Fr 2               Replace:
00116Fr 2  9D 00 07       sta LevelBuf,x
001172r 2  E8             inx
001173r 2  E4 01          cpx 1
001175r 2  D0 F8          bne Replace
001177r 2               
001177r 2  F0 D3          beq GrassTryRow
001179r 2               Exit:
001179r 2  60             rts
00117Ar 2               .endproc
00117Ar 2               .proc PrettyLevel
00117Ar 2  20 rr rr       jsr MakeClouds
00117Dr 2  A2 00          ldx #0
00117Fr 2  86 00          stx 0 ; for BottomGrass later
001181r 2               PrettyPlatforms:
001181r 2  8A             txa
001182r 2  29 0F          and #15
001184r 2  A8             tay
001185r 2  BD 00 07       lda LevelBuf,x
001188r 2  C9 17          cmp #METATILE_PLATFM
00118Ar 2  D0 18          bne FRL_NotPlatform
00118Cr 2  C0 00            cpy #0 ; check for left ledge
00118Er 2  F0 08            beq :+
001190r 2  BD FF 06           lda LevelBuf-1,x
001193r 2  F0 03              beq :+
001195r 2  FE 00 07             inc LevelBuf,x
001198r 2                   :
001198r 2  C0 0F            cpy #15 ; check for right ledge
00119Ar 2  F0 08            beq :+
00119Cr 2  BD 01 07           lda LevelBuf+1,x
00119Fr 2  F0 03              beq :+
0011A1r 2  DE 00 07             dec LevelBuf,x
0011A4r 2                   :
0011A4r 2                 FRL_NotPlatform:
0011A4r 2  E8             inx
0011A5r 2  E0 F0          cpx #$f0
0011A7r 2  90 D8          bcc PrettyPlatforms
0011A9r 2               
0011A9r 2  A2 E0          ldx #$e0
0011ABr 2               BottomGrass:
0011ABr 2  BD 00 07       lda LevelBuf,x
0011AEr 2  C9 15          cmp #METATILE_SOLID
0011B0r 2  D0 0D          bne NotSolid
0011B2r 2                   ; store index the grass starts on if it didn't already start
0011B2r 2  A5 00            lda 0
0011B4r 2  D0 02            bne :+
0011B6r 2  86 00              stx 0
0011B8r 2                   :
0011B8r 2                   ; replace the current tile with grass
0011B8r 2  A9 1D            lda #METATILE_GRASSM
0011BAr 2  9D 00 07         sta LevelBuf,x
0011BDr 2  D0 11            bne WasSolid
0011BFr 2                 NotSolid:
0011BFr 2  A5 00            lda 0
0011C1r 2  F0 0D            beq WasSolid
0011C3r 2  86 01            stx 1
0011C5r 2  8A               txa
0011C6r 2  48               pha
0011C7r 2  20 rr rr         jsr GrassTryRow
0011CAr 2  A9 00            lda #0
0011CCr 2  85 00            sta 0
0011CEr 2  68               pla
0011CFr 2  AA               tax
0011D0r 2                 WasSolid:
0011D0r 2  E8             inx
0011D1r 2  E0 F0          cpx #$f0
0011D3r 2  D0 D6          bne BottomGrass
0011D5r 2                 ; still work even if the platform touches the right edge
0011D5r 2  A5 00          lda 0
0011D7r 2  F0 05          beq :+
0011D9r 2  86 01            stx 1
0011DBr 2  20 rr rr         jsr GrassTryRow
0011DEr 2                 :
0011DEr 2               
0011DEr 2               ; now check for left and right corners
0011DEr 2  A2 EF          ldx #$ef
0011E0r 2               GrassCornerLoop:
0011E0r 2  BD 00 07       lda LevelBuf,x
0011E3r 2  C9 1D          cmp #METATILE_GRASSM
0011E5r 2  D0 4C          bne NotEvenGrass
0011E7r 2  8A             txa
0011E8r 2  48             pha
0011E9r 2  29 F0          and #$f0
0011EBr 2  85 00          sta 0
0011EDr 2  68             pla
0011EEr 2  18 69 01       add #1
0011F1r 2  29 0F          and #15
0011F3r 2  05 00          ora 0
0011F5r 2  A8             tay
0011F6r 2               
0011F6r 2  A9 00          lda #0 ; clear index we'll make by shifting in two values
0011F8r 2  85 01          sta 1
0011FAr 2               
0011FAr 2  B9 00 07       lda LevelBuf,y
0011FDr 2  20 rr rr       jsr IsGrassOrSolid
001200r 2  26 01          rol 1
001202r 2               
001202r 2  8A             txa
001203r 2  38 E9 01       sub #1
001206r 2  29 0F          and #15
001208r 2  05 00          ora 0
00120Ar 2  A8             tay
00120Br 2  B9 00 07       lda LevelBuf,y
00120Er 2  20 rr rr       jsr IsGrassOrSolid
001211r 2  26 01          rol 1
001213r 2               
001213r 2  A4 01          ldy 1
001215r 2  B9 rr rr       lda GrassFromSideTiles,y
001218r 2  9D 00 07       sta LevelBuf,x
00121Br 2               
00121Br 2                 ; make tiles under grass just dirt
00121Br 2  E0 E0          cpx #$e0
00121Dr 2  B0 14          bcs :+
00121Fr 2  BD 10 07       lda LevelBuf+16,x
001222r 2  C9 1C          cmp #METATILE_GRASSL
001224r 2  90 0D          bcc :+
001226r 2  C9 24          cmp #METATILE_DIRT_T+1
001228r 2  B0 09          bcs :+
00122Ar 2  BD 10 07         lda LevelBuf+16,x
00122Dr 2  18 69 04         add #4
001230r 2  9D 10 07         sta LevelBuf+16,x
001233r 2                 :
001233r 2               
001233r 2               NotEvenGrass:
001233r 2  CA             dex
001234r 2  E0 2F          cpx #$2f
001236r 2  D0 A8          bne GrassCornerLoop
001238r 2               
001238r 2  60             rts
001239r 2               GrassFromSideTiles:
001239r 2  1F 1E 1C 1D    .byt METATILE_GRASST, METATILE_GRASSR, METATILE_GRASSL, METATILE_GRASSM
00123Dr 2               .endproc
00123Dr 2               
00123Dr 2               .proc RenderLevelBuf ; We should only need to do this once per level; mostly taken from FHBG
00123Dr 2  A9 00          lda #0
00123Fr 2  8D 05 20       sta PPUSCROLL
001242r 2  8D 05 20       sta PPUSCROLL
001245r 2               
001245r 2  AA             tax
001246r 2  9D 80 06     : sta AttribMap,x
001249r 2  E8             inx
00124Ar 2  E0 40          cpx #64
00124Cr 2  D0 F8          bne :-
00124Er 2               
00124Er 2  A9 20 8D 06    PositionXY 0,   0, 0
001252r 2  20 A9 00 8D  
001256r 2  06 20        
001258r 2  AA             tax
001259r 2               MoreObj:
001259r 2                 ; Draw the top half of the blocks on the current row
001259r 2  A9 10 85 00    .dj_loop #16, 0
00125Dr 2               
00125Dr 2  BD 00 07         lda LevelBuf,x
001260r 2  0A               asl
001261r 2  0A               asl
001262r 2  A8               tay
001263r 2  B9 rr rr         lda MetatileTiledata+0,y
001266r 2  8D 07 20         sta PPUDATA
001269r 2  B9 rr rr         lda MetatileTiledata+1,y
00126Cr 2  8D 07 20         sta PPUDATA
00126Fr 2               
00126Fr 2  E8               inx
001270r 2  C6 00 D0 E9    .end_djl
001274r 2               
001274r 2                 ; Go back and step through that row again!
001274r 2                 ; ( the bottom half still needs drawn )
001274r 2               
001274r 2  8A             txa
001275r 2  38 E9 10 AA    axs #16
001279r 2               
001279r 2                 ; Draw the bottom half of the current row
001279r 2  A9 10 85 00    .dj_loop #16, 0
00127Dr 2  8A               txa
00127Er 2  BD 00 07         lda LevelBuf,x
001281r 2  48               pha
001282r 2  48               pha
001283r 2  A8               tay
001284r 2  B9 rr rr         lda MetatileBecomes,y
001287r 2  9D 00 07         sta LevelBuf,x
00128Ar 2               
00128Ar 2  68               pla    ; get block number
00128Br 2  0A               asl
00128Cr 2  0A               asl
00128Dr 2  A8               tay
00128Er 2  B9 rr rr         lda MetatileTiledata+2,y
001291r 2  8D 07 20         sta PPUDATA
001294r 2  B9 rr rr         lda MetatileTiledata+3,y
001297r 2  8D 07 20         sta PPUDATA
00129Ar 2               
00129Ar 2  68               pla    ; get block number
00129Br 2  A8               tay
00129Cr 2  B9 rr rr         lda MetatileFlags,y
00129Fr 2  48               pha
0012A0r 2  8A               txa
0012A1r 2  A8               tay
0012A2r 2  68               pla
0012A3r 2  29 03            and #3
0012A5r 2  F0 05            beq :+ ; optimization: if it's zero it's already correct
0012A7r 2  09 80            ora #128
0012A9r 2  20 rr rr         jsr ChangeBlockColor
0012ACr 2                 :
0012ACr 2               
0012ACr 2  E8               inx
0012ADr 2  C6 00 D0 CC    .end_djl
0012B1r 2  E0 F0          cpx #256-16 ; skip last 64 bytes (attributes table)
0012B3r 2  D0 A4          jne MoreObj
0012B5r 2               
0012B5r 2  A2 00          ldx #0
0012B7r 2  BD 80 06     : lda AttribMap,x
0012BAr 2  8D 07 20       sta PPUDATA
0012BDr 2  E8             inx
0012BEr 2  E0 40          cpx #64
0012C0r 2  D0 F5          bne :-
0012C2r 2               
0012C2r 2  A9 00          lda #0
0012C4r 2  8D 05 20       sta PPUSCROLL
0012C7r 2  8D 05 20       sta PPUSCROLL
0012CAr 2  60             rts
0012CBr 2               .endproc
0012CBr 2               
0012CBr 2               .proc ChangeBlock ; A-New block, Y-Block index
0012CBr 2  84 01          sty 1
0012CDr 2  86 02          stx 2
0012CFr 2  C9 FF          cmp #<-1 ; if -1, remove the block visually but leave it in LevelBuf and set a bit in CollectMap
0012D1r 2  D0 0F          bne :+
0012D3r 2  20 rr rr         jsr IndexToBitmap ; first set bit in CollectMap
0012D6r 2  19 60 06         ora CollectMap,y
0012D9r 2  99 60 06         sta CollectMap,y
0012DCr 2  A4 01            ldy 1 ; restore Y
0012DEr 2               
0012DEr 2  A9 00            lda #0 ; we'll be replacing with metatile 0
0012E0r 2  F0 03            beq JustUpdateScreen
0012E2r 2                 :
0012E2r 2  99 00 07       sta LevelBuf,y
0012E5r 2               JustUpdateScreen:
0012E5r 2  84 00          sty 0           ; we need Y later when we calculate the PPU address
0012E7r 2  0A             asl
0012E8r 2  0A             asl
0012E9r 2  AA             tax             ; will fetch tiles from MetatileTiledata
0012EAr 2                                 ; now find a slot to put the block update in
0012EAr 2  A0 00          ldy #0
0012ECr 2  B9 rr rr     : lda BlockUpdateA1,y
0012EFr 2  F0 0B          beq :+          ; empty slot found
0012F1r 2  C8             iny
0012F2r 2  C0 04          cpy #MaxNumBlockUpdates
0012F4r 2  D0 F6          bne :-
0012F6r 2  A4 01          ldy 1
0012F8r 2  A6 02          ldx 2
0012FAr 2  18             clc
0012FBr 2  60             rts ;  no free slots
0012FCr 2               :
0012FCr 2  BD rr rr       lda MetatileTiledata+0,x
0012FFr 2  99 rr rr       sta BlockUpdateT1,y
001302r 2  BD rr rr       lda MetatileTiledata+1,x
001305r 2  99 rr rr       sta BlockUpdateT2,y
001308r 2  BD rr rr       lda MetatileTiledata+2,x
00130Br 2  99 rr rr       sta BlockUpdateT3,y
00130Er 2  BD rr rr       lda MetatileTiledata+3,x
001311r 2  99 rr rr       sta BlockUpdateT4,y
001314r 2               
001314r 2  98             tya
001315r 2  AA             tax
001316r 2               
001316r 2  A5 00          lda 0           ; calculate PPU address now
001318r 2  48             pha             ; starting with the top nybble
001319r 2  4A             lsr
00131Ar 2  4A             lsr
00131Br 2  29 3C 4A       alr #%111100    ; <- replacing "lsr, and #%11110"
00131Er 2  A8             tay             ; index into PPURowAddr
00131Fr 2  68             pla
001320r 2  29 0F          and #$0f        ; bottom nybble is the X index
001322r 2  0A             asl             ; multiply by two because blocks are 16 pixels wide
001323r 2  85 00          sta 0
001325r 2  B9 rr rr       lda PPURowAddrHi+0,y
001328r 2  95 rr          sta BlockUpdateA1,x
00132Ar 2  B9 rr rr       lda PPURowAddrHi+1,y
00132Dr 2  95 rr          sta BlockUpdateB1,x
00132Fr 2               
00132Fr 2  B9 rr rr       lda PPURowAddrLo+0,y
001332r 2  18 65 00       add 0
001335r 2  95 rr          sta BlockUpdateA2,x
001337r 2  B9 rr rr       lda PPURowAddrLo+1,y
00133Ar 2  18 65 00       add 0
00133Dr 2  95 rr          sta BlockUpdateB2,x
00133Fr 2  38             sec             ; success
001340r 2  A4 01          ldy 1
001342r 2  A6 02          ldx 2
001344r 2  60             rts
001345r 2               .endproc
001345r 2               
001345r 2               PPURowAddrHi:
001345r 2  20 20 20 20  .repeat 30, I
001349r 2  20 20 20 20  
00134Dr 2  21 21 21 21  
001363r 2                 .byt >($2000+I*32)
001363r 2               .endrep
001363r 2               PPURowAddrLo:
001363r 2  00 20 40 60  .repeat 30, I
001367r 2  80 A0 C0 E0  
00136Br 2  00 20 40 60  
001381r 2                 .byt <($2000+I*32)
001381r 2               .endrep
001381r 2               
001381r 2               .proc ChangeBlockColor ; A-New color (0 to 3), Y-Block index
001381r 2                                      ; http://wiki.nesdev.com/w/index.php/Attribute_table
001381r 2                 AttrIndexTemp = 4
001381r 2                 OnValue = 5
001381r 2                 SaveColor = 6
001381r 2                 SaveX = 7
001381r 2               
001381r 2  86 07          stx SaveX       ; level renderer uses X, so save it
001383r 2  85 06          sta SaveColor
001385r 2  29 03          and #3
001387r 2  AA             tax         ; save the particular color being used
001388r 2  BD rr rr       lda ValueMasks,x  ; start with it unshifted
00138Br 2  85 05          sta OnValue
00138Dr 2                 ; now determine how much to shift
00138Dr 2  A2 00          ldx #0      ; start at no shift
00138Fr 2  98             tya
001390r 2  4A             lsr         ; odd X? move up one
001391r 2  90 01          bcc :+
001393r 2  E8               inx
001394r 2  98           : tya
001395r 2  29 10          and #$10 ;odd Y? move up two
001397r 2  F0 02          beq :+
001399r 2  E8               inx
00139Ar 2  E8               inx
00139Br 2                 :
00139Br 2               
00139Br 2  A5 05          lda OnValue
00139Dr 2  3D rr rr       and ShiftOnMasks,x
0013A0r 2  85 05          sta OnValue
0013A2r 2               
0013A2r 2                 ; Take the level buffer index and make it into an AttribMap index
0013A2r 2  98             tya
0013A3r 2  29 E0 4A       alr #$e0 ; Y half (discard last bit)
0013A6r 2  4A             lsr
0013A7r 2  85 04          sta AttrIndexTemp
0013A9r 2  98             tya
0013AAr 2  29 0E 4A       alr #$e     ; X half (discard last bit)
0013ADr 2  05 04          ora AttrIndexTemp
0013AFr 2  A8             tay
0013B0r 2               
0013B0r 2  B9 80 06       lda AttribMap,y
0013B3r 2  3D rr rr       and ShiftOffMasks,x
0013B6r 2  05 05          ora OnValue
0013B8r 2  99 80 06       sta AttribMap,y
0013BBr 2  85 05          sta OnValue
0013BDr 2  A6 07          ldx SaveX
0013BFr 2               
0013BFr 2  24 06          bit SaveColor
0013C1r 2  10 01          bpl :+
0013C3r 2  60               rts
0013C4r 2                 :
0013C4r 2               ; Now locate a slot to queue the actual change
0013C4r 2  A2 00          ldx #0
0013C6r 2  B5 rr        : lda TileUpdateA1,x
0013C8r 2  F0 07          beq Found
0013CAr 2  E8             inx
0013CBr 2  E0 05          cpx #MaxNumTileUpdates
0013CDr 2  D0 F7          bne :-
0013CFr 2  18             clc ; failed
0013D0r 2  60             rts
0013D1r 2               Found:
0013D1r 2               
0013D1r 2  A5 05          lda OnValue
0013D3r 2  95 rr          sta TileUpdateT,x
0013D5r 2  A9 23          lda #$23
0013D7r 2  95 rr          sta TileUpdateA1,x
0013D9r 2  98             tya
0013DAr 2  18 69 C0       add #$c0
0013DDr 2  95 rr          sta TileUpdateA2,x
0013DFr 2  38             sec
0013E0r 2  A6 07          ldx SaveX
0013E2r 2  60             rts
0013E3r 2               
0013E3r 2               ValueMasks:
0013E3r 2  00             .byt %00000000
0013E4r 2  55             .byt %01010101
0013E5r 2  AA             .byt %10101010
0013E6r 2  FF             .byt %11111111
0013E7r 2               ShiftOnMasks:
0013E7r 2  03             .byt %00000011
0013E8r 2  0C             .byt %00001100
0013E9r 2  30             .byt %00110000
0013EAr 2  C0             .byt %11000000
0013EBr 2               ShiftOffMasks:
0013EBr 2  FC             .byt %11111100
0013ECr 2  F3             .byt %11110011
0013EDr 2  CF             .byt %11001111
0013EEr 2  3F             .byt %00111111
0013EFr 2               .endproc
0013EFr 2               
0013EFr 2               .proc IndexToBitmap ; Y = $yx -> Y = index, A = mask
0013EFr 2  98             tya
0013F0r 2  48             pha
0013F1r 2  4A             lsr
0013F2r 2  4A             lsr
0013F3r 2  4A             lsr
0013F4r 2  85 rr          sta TempVal+1
0013F6r 2  68             pla
0013F7r 2  29 07          and #7
0013F9r 2  A8             tay
0013FAr 2  B9 rr rr       lda BitSelect,y
0013FDr 2  A4 rr          ldy TempVal+1
0013FFr 2  60             rts
001400r 2               .endproc
001400r 2               
001400r 2               .proc AddDelayMetaEdit ; Y = $yx, A = type, 0 = time (destroys 1 and 2)
001400r 2  85 01          sta 1
001402r 2  84 02          sty 2
001404r 2  A0 00          ldy #0
001406r 2  B9 rr rr     : lda DelayedMetaEditType,y
001409r 2  F0 09          beq Found
00140Br 2  C8             iny
00140Cr 2  C0 0A          cpy #MaxDelayedMetaEdits
00140Er 2  D0 F6          bne :-
001410r 2  A4 02          ldy 2
001412r 2  18             clc
001413r 2  60             rts
001414r 2               Found:
001414r 2  A5 00          lda 0
001416r 2  99 rr rr       sta DelayedMetaEditTime,y
001419r 2  A5 01          lda 1
00141Br 2  99 rr rr       sta DelayedMetaEditType,y
00141Er 2  A5 02          lda 2
001420r 2  99 rr rr       sta DelayedMetaEditIndx,y
001423r 2  A4 02          ldy 2
001425r 2  38             sec
001426r 2  60             rts
001427r 2               .endproc
