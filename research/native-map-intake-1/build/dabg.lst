001069r 2               .proc BlockIsSolid
001069r 2  84 rr          sty TempVal+2
00106Br 2  A8             tay
00106Cr 2  B9 rr rr       lda MetatileFlags,y
00106Fr 2  A4 rr          ldy TempVal+2
001071r 2  29 04          and #%100
001073r 2  60             rts
