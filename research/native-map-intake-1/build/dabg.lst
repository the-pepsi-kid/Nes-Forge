0042C5r 2               .proc LevelEditTileTable
0042C5r 2  20 FF FD FE    .byt $20, $FF, $FD, $FE, $FC, $00, $00, $00, $00
0042C9r 2  FC 00 00 00  
0042CDr 2  00           
0042CEr 2  24 85 93 FB    .byt '$', $85, $93, $fb, $fa, $f9, $f8
0042D2r 2  FA F9 F8     
0042D5r 2  F4 F5 83 F6    .byt $f4, $f5, $83, $f6, $81
0042D9r 2  81           
0042DAr 2  80 F0 F0 F0    .byt $80, $F0, $F0, $F0, $F3, $86, $96
0042DEr 2  F3 86 96     
0042E1r 2               .endproc
