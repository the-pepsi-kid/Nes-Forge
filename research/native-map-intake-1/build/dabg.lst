001719r 2  9D rr rr       sta ObjectF1,x
00171Cr 2  84 rr          sty TempVal
00171Er 2  A9 0D          lda #SOUND_ENEMYHURT2
001720r 2  20 rr rr       jsr start_sound
001723r 2  A4 rr          ldy TempVal
001725r 2  60             rts
001726r 2  A9 02        : lda #ENEMY_STATE_STUNNED
