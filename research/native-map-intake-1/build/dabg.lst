000D2Ar 2               .proc PlayerAddScore
000D2Ar 2  A8             tay
000D2Br 2  B9 rr rr       lda BCD64,y
000D2Er 2  48 29 0F 85    unpack TempVal,TempVal+1
000D32r 2  rr 68 4A 4A  
000D36r 2  4A 4A 85 rr  
000D3Ar 2  BC rr rr       ldy PlayerScoreIndex,x
000D3Dr 2  98             tya
000D3Er 2  48             pha
000D3Fr 2  B9 rr rr       lda ScoreDigits+2,y
000D42r 2  48             pha
000D43r 2               
000D43r 2  B9 rr rr       lda ScoreDigits,y
000D46r 2  18 65 rr       add TempVal
000D49r 2  99 rr rr       sta ScoreDigits,y
000D4Cr 2  B9 rr rr       lda ScoreDigits+1,y
000D4Fr 2  18 65 rr       add TempVal+1
000D52r 2  99 rr rr       sta ScoreDigits+1,y
000D55r 2               FixLoop: ; if it goes past 9, carry it over
000D55r 2  B9 rr rr       lda ScoreDigits,y
000D58r 2  C9 3A          cmp #'9'+1 ; 9 or less: no fixing
000D5Ar 2  90 11          bcc Next
000D5Cr 2  38 E9 0A       sub #10
000D5Fr 2  99 rr rr       sta ScoreDigits,y
000D62r 2  86 rr 48 98    isc ScoreDigits+1,y
000D66r 2  AA FE rr rr  
000D6Ar 2  68 A6 rr     
000D6Dr 2               Next:
000D6Dr 2  C8             iny
000D6Er 2  C0 05          cpy #NumScoreDigits
000D70r 2  F0 04          beq Exit
000D72r 2  C0 0A          cpy #NumScoreDigits*2
000D74r 2  D0 DF          bne FixLoop
000D76r 2               Exit:
000D76r 2  68             pla
000D77r 2  85 rr          sta TempVal
000D79r 2  68             pla
000D7Ar 2  A8             tay
000D7Br 2  A5 rr          lda TempVal
000D7Dr 2  D9 rr rr       cmp ScoreDigits+2,y
000D80r 2  F0 0B          beq :+
000D82r 2  B9 rr rr         lda ScoreDigits+2,y
000D85r 2  C9 30            cmp #'0'
000D87r 2  F0 05            beq AddLife
000D89r 2  C9 35            cmp #'5'
000D8Br 2  F0 01            beq AddLife
000D8Dr 2                 :
000D8Dr 2  60             rts
