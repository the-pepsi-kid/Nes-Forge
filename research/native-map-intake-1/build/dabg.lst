0042B1r 2  03 04 09     
0042B4r 2  19 0A 1A 0B    .byt METATILE_EXPLODE, METATILE_CYCLE_OFF_SOLID, METATILE_CYCLE_ON_SOLID, METATILE_CYCLE_OFF_PLATF, METATILE_CYCLE_ON_PLATF
0042B8r 2  1B           
