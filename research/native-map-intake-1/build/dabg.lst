000D8Er 2  B5 rr          lda PlayerLives,x
000D90r 2  C9 09          cmp #9
000D92r 2  F0 02          beq :+
000D94r 2  F6 rr          inc PlayerLives,x
000D96r 2  60           : rts
000D97r 2               .endproc
000D97r 2               
