000000r 2               .macro btr Num, Here
000000r 2               .if .match({Num},"eq")
000000r 2               	beq Here
000000r 2               .elseif .match({Num},"ne")
000000r 2               	bne Here
000000r 2               .elseif .match({Num},"cs")
000000r 2               	bcs Here
000000r 2               .elseif .match({Num},"cc")
000000r 2               	bcc Here
000000r 2               .elseif .match({Num},"vs")
000000r 2               	bvs Here
000000r 2               .elseif .match({Num},"vc")
000000r 2               	bvc Here
000000r 2               .elseif .match({Num},"pl")
000000r 2               	bpl Here
000000r 2               .elseif .match({Num},"mi")
000000r 2               	bmi Here
000000r 2               .endif
000000r 2               .endmacro
000000r 2               .macro bfl Num, Here
