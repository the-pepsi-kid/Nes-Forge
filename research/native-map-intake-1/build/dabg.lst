001011r 2  EA EB EA EB    .byt $ea, $eb, $ea, $eb ; solid grass (bottom left)
001015r 2  EB EB EB EB    .byt $eb, $eb, $eb, $eb ; solid grass (bottom middle)
001019r 2  EB EC EB EC    .byt $eb, $ec, $eb, $ec ; solid grass (bottom right)
00101Dr 2  EA EC EA EC    .byt $ea, $ec, $ea, $ec ; solid grass (bottom tower)
