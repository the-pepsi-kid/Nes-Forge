0042F9r 2               .proc ClearSRAM
0042F9r 2                 lda #$00
0042F9r 2                 sta 0
0042F9r 2                 lda #$60
0042F9r 2                 sta 1
0042F9r 2                 tay
0042F9r 2               Loop:
0042F9r 2                 sta (0),y
0042F9r 2                 iny
0042F9r 2                 bne :-
0042F9r 2                 inc 1
0042F9r 2                 ldx 1
0042F9r 2                 cpx #$7f
0042F9r 2                 beq Exit
0042F9r 2                 bne Loop
0042F9r 2               Exit:
0042F9r 2                 rts
0042F9r 2               .endproc
0042F9r 2               .endif
