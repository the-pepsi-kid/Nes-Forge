0000D9r 2               .proc PutHex
0000D9r 2  48           	pha
0000DAr 2  48           	pha
0000DBr 2  4A           	lsr a
0000DCr 2  4A           	lsr a
0000DDr 2  4A           	lsr a
0000DEr 2  4A           	lsr a
0000DFr 2  AA           	tax
0000E0r 2  BD rr rr     	lda hexdigits,x
0000E3r 2  8D 07 20     	sta PPUDATA
0000E6r 2  68           	pla
0000E7r 2  29 0F        	and #$0f
0000E9r 2  AA           	tax
0000EAr 2  BD rr rr     	lda hexdigits,x
0000EDr 2  8D 07 20     	sta PPUDATA
0000F0r 2  68           	pla
0000F1r 2  60           	rts
0000F2r 2  30 31 32 33  hexdigits:	.byt "0123456789ABCDEF"
0000F6r 2  34 35 36 37  
0000FAr 2  38 39 41 42  
000102r 2               .endproc
000102r 2               
000102r 2               .proc PutDecimal ; Prints with anywhere from 1 to 3 digits
000102r 2  C9 0A           cmp #10 ; only one char
000104r 2  B0 07           bcs :+
000106r 2  18 69 30          add #'0'    ; char is number+'0'
000109r 2  8D 07 20          sta PPUDATA
00010Cr 2  60                rts
00010Dr 2                  :
00010Dr 2               
00010Dr 2                  ; the hundreds digit if necessary
00010Dr 2  C9 C8           cmp #200
00010Fr 2  90 0B           bcc LessThan200
000111r 2  A2 32           ldx #'2'
000113r 2  8E 07 20        stx PPUDATA
000116r 2  38 E9 C8        sub #200
000119r 2  4C rr rr        jmp :+
00011Cr 2               LessThan200:
00011Cr 2  C9 64           cmp #100
00011Er 2  90 08           bcc :+
000120r 2  A2 31           ldx #'1'
000122r 2  8E 07 20        stx PPUDATA
000125r 2  38 E9 64        sub #100
000128r 2               :
000128r 2  A2 30           ldx #'0'    ; now calculate the tens digit
00012Ar 2  C9 0A        :  cmp #10
00012Cr 2  90 06           bcc Finish
00012Er 2  E9 0A           sbc #10     ; carry will be set if this runs anyway
000130r 2  E8              inx
000131r 2  4C rr rr        jmp :-
000134r 2               Finish:
000134r 2  8E 07 20        stx PPUDATA ; display tens digit
000137r 2  18 69 30        add #'0'
00013Ar 2  8D 07 20        sta PPUDATA ; display ones digit
00013Dr 2  60              rts
00013Er 2               .endproc
00013Er 2               .proc ClearName
00013Er 2               ;Clear the nametable
00013Er 2  A2 20          ldx #$20
000140r 2  A0 00          ldy #$00
000142r 2  8E 06 20       stx PPUADDR
000145r 2  8C 06 20       sty PPUADDR
000148r 2  A2 40          ldx #64
00014Ar 2  A0 04          ldy #4
00014Cr 2  A9 20          lda #' '
00014Er 2  8D 07 20     : sta PPUDATA
000151r 2  E8             inx
000152r 2  D0 FA          bne :-
000154r 2  88             dey
000155r 2  D0 F7          bne :-
000157r 2               ;Clear the attributes
000157r 2  A0 40          ldy #64
000159r 2  A9 00          lda #0
00015Br 2  88           : dey
00015Cr 2  D0 FD          bne :-
00015Er 2  8D 05 20       sta PPUSCROLL
000161r 2  8D 05 20       sta PPUSCROLL
000164r 2  60             rts
000165r 2               .endproc
000165r 2               
000165r 2               .proc WaitForKey
000165r 2  20 rr rr     : jsr ReadJoy
000168r 2  AD rr rr       lda keydown
00016Br 2  0D rr rr       ora keydown+1
00016Er 2               .ifdef fourscore
00016Er 2  0D rr rr       ora keydown+2
000171r 2  0D rr rr       ora keydown+3
000174r 2               .endif
000174r 2  F0 EF          beq :-
000176r 2  AD rr rr       lda keylast
000179r 2  0D rr rr       ora keylast+1
00017Cr 2               .ifdef fourscore
00017Cr 2  0D rr rr       ora keylast+2
00017Fr 2  0D rr rr       ora keylast+3
000182r 2               .endif
000182r 2  D0 E1          bne :-
000184r 2  60             rts
000185r 2               .endproc
000185r 2               .proc PutStringImmediate
000185r 2               	DPL = $02
000185r 2               	DPH = $03
000185r 2  68           	pla					; Get the low part of "return" address
000186r 2                                       ; (data start address)
000186r 2  85 02        	sta     DPL
000188r 2  68           	pla
000189r 2  85 03        	sta     DPH         ; Get the high part of "return" address
00018Br 2                                       ; (data start address)
00018Br 2               						; Note: actually we're pointing one short
00018Br 2  A0 01        PSINB:	ldy #1
00018Dr 2  B1 02        	lda (DPL),y         ; Get the next string character
00018Fr 2  E6 02        	inc DPL             ; update the pointer
000191r 2  D0 02        	bne PSICHO          ; if not, we're pointing to next character
000193r 2  E6 03        	inc DPH             ; account for page crossing
000195r 2  09 00        PSICHO:	ora #0          ; Set flags according to contents of
000197r 2                                       ;    Accumulator
000197r 2  F0 06        	beq     PSIX1       ; don't print the final NULL
000199r 2  8D 07 20     	sta PPUDATA         ; write it out
00019Cr 2  4C rr rr     	jmp     PSINB       ; back around
00019Fr 2  E6 02        PSIX1:	inc     DPL     ;
0001A1r 2  D0 02        	bne     PSIX2       ;
0001A3r 2  E6 03        	inc     DPH         ; account for page crossing
0001A5r 2  6C 02 00     PSIX2:	jmp     (DPL)   ; return to byte following final NULL
0001A8r 2               .endproc
0001A8r 2               .macro LoadPalette Addr
0001A8r 2                   lda #0
0001A8r 2                   sta PPUMASK
0001A8r 2               	lda #$3F
0001A8r 2               	sta PPUADDR
0001A8r 2               	lda #$00
0001A8r 2               	sta PPUADDR
0001A8r 2               	ldy #0
0001A8r 2               :	lda Addr,y
0001A8r 2               	sta PPUDATA
0001A8r 2               	iny
0001A8r 2               	cpy #16
0001A8r 2               	bne :-
0001A8r 2               
0001A8r 2               	ldy #0
0001A8r 2               :	lda Addr,y
0001A8r 2               	sta PPUDATA
0001A8r 2               	iny
0001A8r 2               	cpy #16
0001A8r 2               	bne :-
0001A8r 2               .endmacro
0001A8r 2               .macro LoadNametable Addr
0001A8r 2               	lda #$20
0001A8r 2               	sta PPUADDR
0001A8r 2               	lda #$00
0001A8r 2               	sta PPUADDR
0001A8r 2               
0001A8r 2               	lda #<Addr
0001A8r 2               	sta 0
0001A8r 2               	lda #>Addr
0001A8r 2               	sta 1
0001A8r 2               	ldx #4
0001A8r 2               	ldy #0
0001A8r 2               :	lda ($0), y
0001A8r 2               	sta PPUDATA
0001A8r 2               	iny
0001A8r 2               	bne :-
0001A8r 2               	inc 1
0001A8r 2               	dex
0001A8r 2               	bne :-
0001A8r 2                   lda #0
0001A8r 2                   sta PPUSCROLL
0001A8r 2                   sta PPUSCROLL
0001A8r 2               .endmacro
0001A8r 2               .proc rand_8    ; From some site
0001A8r 2  A5 rr          lda   r_seed  ; get seed
0001AAr 2  29 B8          and   #$B8    ; mask non feedback bits
0001ACr 2                               ; for maximal length run with 8 bits we need
0001ACr 2                               ; taps at b7, b5, b4 and b3
0001ACr 2  A2 05          ldx   #$05    ; bit count (shift top 5 bits)
0001AEr 2  A0 00          ldy   #$00    ; clear feedback count
0001B0r 2               F_loop:
0001B0r 2  0A             asl   A       ; shift bit into carry
0001B1r 2  90 01          bcc   bit_clr ; branch if bit = 0
0001B3r 2               
0001B3r 2  C8             iny           ; increment feedback count (b0 is XOR all the
0001B4r 2                               ; shifted bits from A)
0001B4r 2               bit_clr:
0001B4r 2  CA             dex           ; decrement count
0001B5r 2  D0 F9          bne   F_loop  ; loop if not all done
0001B7r 2               no_clr:
0001B7r 2  98             tya           ; copy feedback count
0001B8r 2  4A             lsr   A       ; bit 0 into Cb
0001B9r 2  A5 rr          lda   r_seed  ; get seed back
0001BBr 2  2A             rol   A       ; rotate carry into byte
0001BCr 2  85 rr          sta   r_seed  ; save number as next seed
0001BEr 2  60             rts           ; done
0001BFr 2               .endproc
0001BFr 2               
0001BFr 2               .proc BitSelect
0001BFr 2  01            .byt %00000001
0001C0r 2  02            .byt %00000010
0001C1r 2  04            .byt %00000100
0001C2r 2  08            .byt %00001000
0001C3r 2  10            .byt %00010000
0001C4r 2  20            .byt %00100000
0001C5r 2  40            .byt %01000000
0001C6r 2  80            .byt %10000000
0001C7r 2               .endproc
0001C7r 2               .proc BitCancel
0001C7r 2  FE            .byt %11111110
0001C8r 2  FD            .byt %11111101
0001C9r 2  FB            .byt %11111011
0001CAr 2  F7            .byt %11110111
0001CBr 2  EF            .byt %11101111
0001CCr 2  DF            .byt %11011111
0001CDr 2  BF            .byt %10111111
0001CEr 2  7F            .byt %01111111
0001CFr 2               .endproc
0001CFr 2               
0001CFr 2               .macro neg16 val
0001CFr 2                 sec             ;Ensure carry is set
0001CFr 2                 lda #0          ;Load constant zero
0001CFr 2                 sbc val+0       ;... subtract the least significant byte
0001CFr 2                 sta val+0       ;... and store the result
0001CFr 2                 lda #0          ;Load constant zero again
0001CFr 2                 sbc val+1       ;... subtract the most significant byte
0001CFr 2                 sta val+1       ;... and store the result
0001CFr 2               .endmacro
