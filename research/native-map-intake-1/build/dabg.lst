004248r 1               .include "unpkb.s"
004248r 2               ;
004248r 2               ; unpkb.s - RLE unpacking
004248r 2               ;
004248r 2               ; Copyright (c) 2008 Damian Yerrick
004248r 2               ;
004248r 2               ; Copying and distribution of this file, with or without
004248r 2               ; modification, are permitted in any medium without royalty
004248r 2               ; provided the copyright notice and this notice are preserved.
004248r 2               ; This file is offered as-is, without any warranty.
004248r 2               ;
004248r 2               
004248r 2               ;;; Version history
004248r 2               ;
004248r 2               ;   2008 Dec: Optimized to better use the Y register, on a
004248r 2               ;             suggestion by blargg
004248r 2               ;   2003 Oct: Ported for use with ca65 assembler
004248r 2               ;   2000:     Initial release, for x816 assembler
004248r 2               
004248r 2               
004248r 2               .export PKB_unpackblk, PKB_unpack, PKB_source, PKB_len
004248r 2               
004248r 2               
004248r 2               ;;; Configuration
004248r 2               ;
004248r 2               ; Set PKB_outport to whatever data port you want PackBits to use.
004248r 2               ; (Slightly more modification is necessary for memory-to-memory
004248r 2               ; unpacking.)
004248r 2               ;
004248r 2               PKB_outport = $2007         ;NES PPU data register
004248r 2               
004248r 2               ;
004248r 2               ; Set PKB_source to the address in direct page (i.e. zero page)
004248r 2               ; where the pointer to packed data is stored.
004248r 2               ;
004248r 2               PKB_source  = $00
004248r 2               PKB_len     = $02
004248r 2               
004248r 2               .segment "CODE"
004248r 2               
004248r 2               ;
004248r 2               ; PKB_unpackblk
004248r 2               ; Unpack PackBits() encoded data from memory at (PKB_source)
004248r 2               ; to a character device such as the NES PPU data register.
004248r 2               ;
004248r 2               ; This entry point assumes a 16-bit length word in network
004248r 2               ; byte order before the data.
004248r 2               PKB_unpackblk:
004248r 2               
004248r 2  A0 00          ldy #0
00424Ar 2  B1 00          lda (PKB_source),y
00424Cr 2  E6 00          inc PKB_source
00424Er 2  D0 02          bne :+
004250r 2  E6 01          inc PKB_source+1
004252r 2               :
004252r 2  85 03          sta PKB_len+1
004254r 2  B1 00          lda (PKB_source),y
004256r 2  E6 00          inc PKB_source
004258r 2  D0 02          bne :+
00425Ar 2  E6 01          inc PKB_source+1
00425Cr 2               :
00425Cr 2  85 02          sta PKB_len
00425Er 2               
00425Er 2               ; This entry point assumes a 16-bit length word in host byte order
00425Er 2               ; at PKB_len.
00425Er 2               PKB_unpack:
00425Er 2  A5 02          lda PKB_len
004260r 2  F0 02          beq :+
004262r 2  E6 03          inc PKB_len+1   ;trick to allow easier 16-bit decrement
004264r 2               :
004264r 2                 ; optimization suggested by blargg is to hold the low byte
004264r 2                 ; in Y instead of using constant Y=0; saves 3 cycles per
004264r 2                 ; compressed byte
004264r 2  A4 00          ldy PKB_source
004266r 2  A9 00          lda #0
004268r 2  85 00          sta PKB_source
00426Ar 2               
00426Ar 2               @PKB_loop:
00426Ar 2  B1 00          lda (PKB_source),y
00426Cr 2  30 21          bmi @PKB_run
00426Er 2               
00426Er 2  C8             iny  ; got a literal string
00426Fr 2  D0 02          bne :+
004271r 2  E6 01          inc PKB_source+1
004273r 2               :
004273r 2  AA             tax
004274r 2  E8             inx
004275r 2               @PKB_strloop:
004275r 2  B1 00          lda (PKB_source),y
004277r 2  C8             iny
004278r 2  D0 02          bne :+
00427Ar 2  E6 01          inc PKB_source+1
00427Cr 2               :
00427Cr 2  8D 07 20       sta PKB_outport
00427Fr 2  C6 02          dec PKB_len
004281r 2  D0 04          bne :+
004283r 2  C6 03          dec PKB_len+1
004285r 2  F0 05          beq @PKB_rts
004287r 2               :
004287r 2  CA             dex
004288r 2  D0 EB          bne @PKB_strloop
00428Ar 2  F0 DE          beq @PKB_loop
00428Cr 2               
00428Cr 2               @PKB_rts:
00428Cr 2  84 00          sty PKB_source  ; restore the address after the compressed data
00428Er 2  60             rts
00428Fr 2               
00428Fr 2               @PKB_run:
00428Fr 2  C8             iny  ; got a run
004290r 2  D0 02          bne :+
004292r 2  E6 01          inc PKB_source+1
004294r 2               :
004294r 2  AA             tax
004295r 2  CA             dex
004296r 2  B1 00          lda (PKB_source),y  ; get the run contents
004298r 2  C8             iny
004299r 2  D0 02          bne @PKB_runloop
00429Br 2  E6 01          inc PKB_source+1
00429Dr 2               @PKB_runloop:
00429Dr 2  8D 07 20       sta PKB_outport
0042A0r 2  C6 02          dec PKB_len
0042A2r 2  D0 04          bne :+
0042A4r 2  C6 03          dec PKB_len+1
0042A6r 2  F0 E4          beq @PKB_rts
0042A8r 2               :
0042A8r 2  E8             inx
0042A9r 2  D0 F2          bne @PKB_runloop
0042ABr 2  F0 BD          beq @PKB_loop
0042ADr 2               
