00412Ar 2               .proc DecodeLevelMap
00412Ar 2               BufPos = 0
00412Ar 2               Param = 1
00412Ar 2               Temp = 2
00412Ar 2               Code = 3
00412Ar 2               Width = 4
00412Ar 2               Height = 5
00412Ar 2               Pointer = 6 ;is also 7
00412Ar 2               BlockId = 8
00412Ar 2  AD rr rr       lda LevelMapPointer+0 ; LevelMapPointer isn't in zeropage, so copy it there
00412Dr 2  85 06          sta Pointer+0
00412Fr 2  AD rr rr       lda LevelMapPointer+1
004132r 2  85 07          sta Pointer+1
004134r 2               
004134r 2  A9 01          lda #1
004136r 2  8D rr rr       sta IsMappedLevel
004139r 2  A0 00          ldy #0
00413Br 2               Loop:
00413Br 2  B1 06          lda (Pointer),y
00413Dr 2  85 00          sta BufPos
00413Fr 2  C8             iny
004140r 2  B1 06          lda (Pointer),y
004142r 2  D0 11          bne :+
004144r 2  A5 00            lda BufPos ; reload the position, we need that
004146r 2  48 29 0F 8D      unpack LevelEditStartX, LevelEditStartY
00414Ar 2  rr rr 68 4A  
00414Er 2  4A 4A 4A 8D  
004154r 2  60               rts
004155r 2  C8           : iny
004156r 2               
004156r 2  48             pha ; get param
004157r 2  29 0F          and #15
004159r 2  85 01          sta Param
00415Br 2  AA             tax ; just in case this needs to use the param as a block number
00415Cr 2  BD rr rr       lda LevelData_MetaList,x
00415Fr 2  85 08          sta BlockId
004161r 2  68             pla
004162r 2               
004162r 2  29 F0          and #$f0 ; get function
004164r 2  4A             lsr
004165r 2  4A             lsr
004166r 2  4A             lsr
004167r 2               
004167r 2  84 02          sty Temp
004169r 2  20 rr rr       jsr Call
00416Cr 2  A4 02          ldy Temp
00416Er 2  4C rr rr       jmp Loop
004171r 2               Call:
004171r 2  AA             tax
004172r 2  4A             lsr
004173r 2  85 03          sta Code
004175r 2  BD rr rr       lda ObjectTypeTable+1,x
004178r 2  48             pha
004179r 2  BD rr rr       lda ObjectTypeTable+0,x
00417Cr 2  48             pha
00417Dr 2  A5 03          lda Code
00417Fr 2  A6 00          ldx BufPos
004181r 2  60             rts
004182r 2               ObjectTypeTable:
004182r 2  rr rr          .raddr ZeroType
004184r 2  rr rr          .raddr OneType
004186r 2  rr rr          .raddr HorzRepeat ; solid
004188r 2  rr rr          .raddr HorzRepeat ; empty
00418Ar 2  rr rr          .raddr HorzRepeat ; cycle off solid
00418Cr 2  rr rr          .raddr HorzRepeat ; cycle on solid
00418Er 2  rr rr          .raddr HorzRepeat ; platform
004190r 2  rr rr          .raddr HorzRepeat ; cycle off platform
004192r 2  rr rr          .raddr HorzRepeat ; cycle on platform
004194r 2  rr rr          .raddr VertRepeat ; solid
004196r 2  rr rr          .raddr VertRepeat ; empty
004198r 2  rr rr          .raddr VertRepeat ; cycle off solid
00419Ar 2  rr rr          .raddr VertRepeat ; cycle on solid
00419Cr 2  rr rr          .raddr RectFill
00419Er 2               ZeroType:
00419Er 2  A5 08          lda BlockId
0041A0r 2  9D 00 07       sta LevelBuf,x
0041A3r 2  60             rts
0041A4r 2               OneType:
