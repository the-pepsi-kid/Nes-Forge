000FC1r 2  20 20 20 20    .byt $20, $20, $20, $20 ;
000FC5r 2  20 20 20 20    .byt $20, $20, $20, $20 ;
000FC9r 2  20 20 20 20    .byt $20, $20, $20, $20 ;
000FCDr 2  20 20 20 20    .byt $20, $20, $20, $20 ;
000FD1r 2  B0 B1 B0 B1    .byt $b0, $b1, $b0, $b1 ; teleport left
000FD5r 2  B2 B3 B2 B3    .byt $b2, $b3, $b2, $b3 ; teleport right
000FD9r 2  20 20 83 83    .byt $20, $20, $83, $83 ; bomb trap
