000046r 2               Attract:
000046r 2  AD rr rr       lda keydown
000049r 2  29 10          and #KEY_START
00004Br 2  F0 03 4C rr    jne reset
00004Fr 2  rr           
000050r 2  A9 00          lda #0
000052r 2  8D rr rr       sta keydown
000055r 2               
000055r 2                 ; Dumb little AI
000055r 2  A2 00          ldx #0
000057r 2               Loop:
000057r 2  BD rr rr       lda ObjectF1,x
00005Ar 2  F0 26          beq No
00005Cr 2  BD rr rr       lda ObjectPYH,x
00005Fr 2  CD rr rr       cmp PlayerPYH
000062r 2  D0 1E          bne No
000064r 2  BD rr rr       lda ObjectF2,x
000067r 2  D0 19          bne No
000069r 2  AD rr rr       lda retraces
00006Cr 2  29 08          and #8
00006Er 2  0A             asl ; 16
00006Fr 2  0A             asl ; 32
000070r 2  0A             asl ; 64
000071r 2  8D rr rr       sta keydown
000074r 2               
000074r 2  AD rr rr       lda PlayerPX
000077r 2  DD rr rr       cmp ObjectPX,x
00007Ar 2  A9 00          lda #0
00007Cr 2  69 00          adc #0
00007Er 2  8D rr rr       sta PlayerDir
000081r 2  60             rts
000082r 2               No:
000082r 2  E8             inx
000083r 2  E0 0E          cpx #ObjectLen
000085r 2  D0 D0          bne Loop
000087r 2               
000087r 2  AD rr rr       lda PlayerPX
00008Ar 2  4A             lsr
00008Br 2  4A             lsr
00008Cr 2  4A             lsr
00008Dr 2  4A             lsr
00008Er 2  85 00          sta 0
000090r 2  AD rr rr       lda PlayerPYH
000093r 2  18 69 10       add #16
000096r 2  29 F0          and #$f0
000098r 2  05 00          ora 0
00009Ar 2  A8             tay
00009Br 2  B9 00 07       lda LevelBuf,y
00009Er 2  D0 08          bne :+
0000A0r 2  AD rr rr         lda PlayerDir
0000A3r 2  49 01            eor #1
0000A5r 2  8D rr rr         sta PlayerDir
0000A8r 2                 :
0000A8r 2               
0000A8r 2  AE rr rr       ldx PlayerDir
0000ABr 2  BD rr rr       lda Directions,x
0000AEr 2  8D rr rr       sta keydown
0000B1r 2               
0000B1r 2               
0000B1r 2  60             rts
0000B2r 2               
