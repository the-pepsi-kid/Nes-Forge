003D82r 2               
003D82r 2               .proc LoadLevelParams ; A = level to load
003D82r 2  AC rr rr       ldy LevelEditMode
003D85r 2  D0 22          bne EditMode
003D87r 2               
003D87r 2  48             pha
003D88r 2  A9 00          lda #0
003D8Ar 2  85 01          sta 1
003D8Cr 2  68             pla
003D8Dr 2  0A             asl ; don't need a ROL after every single ASL due to range of level numbers
003D8Er 2  0A             asl ; 1 increases support to 64 levels, 2 to 128 etc, but we only need 64 currently
003D8Fr 2  0A             asl
003D90r 2  26 01          rol 1
003D92r 2  18 69 rr       add #<LevelParamTable
003D95r 2  85 00          sta 0
003D97r 2               
003D97r 2  A5 01          lda 1
003D99r 2  69 rr          adc #>LevelParamTable
003D9Br 2  85 01          sta 1
003D9Dr 2               
003D9Dr 2  A0 00          ldy #0
003D9Fr 2  B1 00        : lda (0),y
003DA1r 2  99 rr rr       sta LevelConfigBytes,y
003DA4r 2  C8             iny
003DA5r 2  C0 08          cpy #8
003DA7r 2  D0 F6          bne :-
003DA9r 2               
003DA9r 2               EditMode:
003DA9r 2               ; goal type and goal param are stored in the same byte
003DA9r 2  AD rr rr       lda LevelConfigBytes
003DACr 2  48             pha
003DADr 2  4A             lsr
003DAEr 2  4A             lsr
003DAFr 2  8D rr rr       sta LevelGoalParam
003DB2r 2  EE rr rr       inc LevelGoalParam
003DB5r 2               
003DB5r 2  AD rr rr       lda IsScoreMode ; make the level longer if it's versus score
003DB8r 2  F0 0B          beq :+
003DBAr 2  AD rr rr       lda LevelGoalParam
003DBDr 2  0A             asl
003DBEr 2  18 6D rr rr    add LevelGoalParam
003DC2r 2  8D rr rr       sta LevelGoalParam
003DC5r 2               :
003DC5r 2               
003DC5r 2  68             pla
003DC6r 2  29 03          and #3
003DC8r 2  8D rr rr       sta LevelGoalType
003DCBr 2               
003DCBr 2               ; fetch the four different types of enemies
003DCBr 2  AD rr rr       lda LevelConfigBytes+2
003DCEr 2  85 00          sta 0
003DD0r 2  AD rr rr       lda LevelConfigBytes+3
003DD3r 2  85 01          sta 1
003DD5r 2  AD rr rr       lda LevelConfigBytes+4
003DD8r 2  85 02          sta 2
003DDAr 2  AD rr rr       lda LevelConfigBytes+5
003DDDr 2  85 03          sta 3
003DDFr 2               
003DDFr 2               ; get max enemies per screen, then fill out the big 16 entry table based on the distribution flag
003DDFr 2  AD rr rr       lda LevelConfigBytes+1
003DE2r 2  48             pha
003DE3r 2  29 07          and #7
003DE5r 2  8D rr rr       sta MaxScreenEnemies
003DE8r 2  EE rr rr       inc MaxScreenEnemies
003DEBr 2  68             pla     ; the distribution defaults to 4/16 chance for all enemies
003DECr 2  A2 00          ldx #0  ; but if the flag for it is set, the chance is changed to 5/16 for the first two
003DEEr 2  A0 00          ldy #0  ; and 3/16 for the last two
003DF0r 2  29 08          and #DIST_SPLIT53
003DF2r 2  AA             tax
003DF3r 2               
003DF3r 2  BD rr rr     : lda EnemyDistributionTable,x
003DF6r 2  84 04          sty 4
003DF8r 2  A8             tay
003DF9r 2  B9 00 00       lda 0, y ; look up from list of enemies for this level
003DFCr 2  A4 04          ldy 4
003DFEr 2  99 rr rr       sta LevelEnemyPool,y
003E01r 2  E8             inx
003E02r 2  C8             iny
003E03r 2  C0 10          cpy #16
003E05r 2  D0 EC          bne :-
003E07r 2               
003E07r 2               ; apply level effects
003E07r 2  AD rr rr       lda LevelConfigBytes+1
003E0Ar 2  29 F0          and #$f0
003E0Cr 2  C9 40          cmp #EFFECT_NOCYCLE
003E0Er 2  D0 04          bne :+
003E10r 2  EE rr rr       inc NoLevelCycle
003E13r 2  60             rts
003E14r 2  C9 10        : cmp #EFFECT_SCROLL1
003E16r 2  D0 04          bne :+
003E18r 2  A9 01          lda #1
003E1Ar 2  85 rr          sta ScrollMode
003E1Cr 2  C9 20        : cmp #EFFECT_SCROLL2
003E1Er 2  D0 05          bne :+
003E20r 2  A9 02          lda #2
003E22r 2  85 rr          sta ScrollMode
003E24r 2  60             rts
003E25r 2  C9 30        : cmp #EFFECT_SCROLL3
003E27r 2  D0 05          bne :+
003E29r 2  A9 03          lda #3
003E2Br 2  85 rr          sta ScrollMode
003E2Dr 2  60             rts
003E2Er 2               :
003E2Er 2  60             rts
003E2Fr 2               .endproc
003E2Fr 2               
003E2Fr 2               DIST_EQUAL4   = 0 << 3
003E2Fr 2               DIST_SPLIT53  = 1 << 3
