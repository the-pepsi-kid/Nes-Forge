0042E8r 2  05 rr          ora keydown+2
0042EAr 2  05 rr          ora keydown+3
0042ECr 2               .endif
0042ECr 2  85 rr          sta keydown
0042EEr 2  A5 rr          lda keylast+1
0042F0r 2  05 rr          ora keylast
0042F2r 2               .ifdef fourscore
0042F2r 2  05 rr          ora keylast+2
0042F4r 2  05 rr          ora keylast+3
0042F6r 2               .endif
0042F6r 2  85 rr          sta keylast
0042F8r 2  60             rts
