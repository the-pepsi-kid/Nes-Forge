001427r 2               .proc RunBullets
001427r 2  A9 00          lda #0
001429r 2  85 00          sta 0 ; current bullet counter
00142Br 2               
00142Br 2  AA             tax   ; clear bullet map out first
00142Cr 2  9D C0 06     : sta BulletMap+0,x
00142Fr 2  9D C8 06       sta BulletMap+8,x
001432r 2  9D D0 06       sta BulletMap+16,x
001435r 2  9D D8 06       sta BulletMap+24,x
001438r 2  9D E0 06       sta BulletMap+32,x
00143Br 2  9D E8 06       sta BulletMap+40,x
00143Er 2  9D F0 06       sta BulletMap+48,x
001441r 2  9D F8 06       sta BulletMap+56,x
001444r 2  E8             inx
001445r 2  E0 08          cpx #8
001447r 2  D0 E3          bne :-
001449r 2               
001449r 2  A4 rr          ldy OamPtr
00144Br 2               
00144Br 2               BulletLoop:
00144Br 2  A6 00          ldx 0
00144Dr 2  BD rr rr       lda BulletF,x
001450r 2  30 03 4C rr    jpl SkipBullet
001454r 2  rr           
001455r 2               
001455r 2  BD rr rr       lda BulletPXL,x
001458r 2  18 7D rr rr    add BulletVXL,x
00145Cr 2  9D rr rr       sta BulletPXL,x
00145Fr 2               
00145Fr 2  BD rr rr       lda BulletPX,x
001462r 2  7D rr rr       adc BulletVX,x
001465r 2  9D rr rr       sta BulletPX,x
001468r 2               
001468r 2  BD rr rr       lda BulletPYL,x
00146Br 2  18 7D rr rr    add BulletVYL,x
00146Fr 2  9D rr rr       sta BulletPYL,x
001472r 2               
001472r 2  BD rr rr       lda BulletPY,x
001475r 2  7D rr rr       adc BulletVY,x
001478r 2  9D rr rr       sta BulletPY,x
00147Br 2               
00147Br 2  84 rr          sty TempVal+1
00147Dr 2                 ; write to bullet map: 00yyyxxx
00147Dr 2  BD rr rr       lda BulletPY,x
001480r 2  4A             lsr
001481r 2  4A             lsr
001482r 2  29 38          and #%111000
001484r 2  85 01          sta 1 ; Y is used for both versions
001486r 2  BD rr rr       lda BulletPX,x
001489r 2  29 E0 4A       alr #%11100000
00148Cr 2  85 02          sta 2
00148Er 2  4A             lsr ; ALR already takes care of the first shift
00148Fr 2  4A             lsr
001490r 2  4A             lsr
001491r 2  4A             lsr
001492r 2  05 01          ora 1
001494r 2  A8             tay
001495r 2  A9 01          lda #1
001497r 2  99 C0 06       sta BulletMap,y
00149Ar 2  A5 02          lda 2
00149Cr 2  18 69 07       add #7
00149Fr 2  29 70          and #%01110000
0014A1r 2  C5 02          cmp 2
