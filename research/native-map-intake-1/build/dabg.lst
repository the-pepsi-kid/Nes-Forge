0059AFr 1               .segment "INESHDR"
000000r 1  4E 45 53 1A    .byt "NES", $1A
000004r 1  02             .byt 2     ; PRG in 16kb units
000005r 1  00             .byt 0     ; CHR in 8kb units
000006r 1  00             .byt 0     ; horizontal mirroring
000007r 1  08             .byt %1000 ; NES 2.0
000008r 1  00             .byt 0     ; extra mapper bits
000009r 1  00             .byt 0     ; extra PRG/CHR bits
00000Ar 1  00             .byt $00   ; no PRG RAM
00000Br 1  07             .byt $07   ; 8 kb of CHR RAM
00000Cr 1  00             .byt 0     ; NTSC (PAL works but no speed adjustments are made)
00000Dr 1  00             .byt 0     ; regular PPU
