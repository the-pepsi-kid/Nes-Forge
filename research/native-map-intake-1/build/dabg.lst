000000r 2               .macro inw mem
000000r 2                 inc mem+0
000000r 2                 bne :+
000000r 2                 inc mem+1
000000r 2               :
000000r 2               .endmacro
000000r 2               
000000r 2               .macro dew mem
000000r 2                 lda mem+0
