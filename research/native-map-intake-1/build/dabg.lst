001747r 2  C9 10          cmp #16
001749r 2  D0 1E          bne :+
00174Br 2  A9 0A            lda #OBJECT_BOMB*2
00174Dr 2  9D rr rr         sta ObjectF1,x
001750r 2  A9 03            lda #EXTOBJ_POOF
001752r 2  9D rr rr         sta ObjectF3,x
001755r 2  A9 0C            lda #12
001757r 2  9D rr rr         sta ObjectTimer,x
00175Ar 2                   ; give a boost
